---
/**
 * The 404 page (spec 0004).
 *
 * It is a real prerendered route, so it lands in `dist/client/404.html` like
 * any other page and carries the site's own header and footer. What makes it
 * an actual 404 rather than a page that happens to say so is
 * `assets.not_found_handling: "404-page"` in `wrangler.jsonc`: that is what
 * tells Cloudflare's static assets layer to serve this file, with a 404
 * status, for any path that matches nothing.
 *
 * This page is not in the nav, so nothing on it carries `aria-current`.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import { resolveLocale } from '../i18n/locales';
import { getNotFoundPage } from '../lib/content';

const lang = resolveLocale(Astro.currentLocale);
const page = await getNotFoundPage(lang);
---

<PageLayout title={page.seo.title} description={page.seo.description}>
  <Section tone="canvas" width="narrow" labelledBy="page-title">
    <h1 id="page-title">{page.heading}</h1>
    <p class="mt-4 text-lead">{page.text}</p>
    <p class="mt-8">
      <Button href={page.button.href}>{page.button.label}</Button>
    </p>
  </Section>
</PageLayout>
