---
/**
 * The front door. A stub: the frame, the metadata and the hero's heading and
 * subheading, all from content. Feature 6 builds the real home page, every
 * section of it.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/ui/Section.astro';
import { resolveLocale } from '../i18n/locales';
import { getHomePage } from '../lib/content';

const lang = resolveLocale(Astro.currentLocale);
const home = await getHomePage(lang);
---

<PageLayout title={home.seo.title} description={home.seo.description}>
  <Section tone="white" labelledBy="page-title">
    <h1 id="page-title">{home.hero.heading}</h1>
    <p class="mt-4 max-w-narrow text-lead">{home.hero.subheading}</p>
  </Section>
</PageLayout>
