---
/**
 * The front door (spec 0005): five sections, in order, every word and image
 * of them from a content entry.
 *
 * This file is the only place that knows the page's shape. It owns the tone of
 * each band (the `canvas` and `raised` alternation spec 0003 asks a page to set),
 * and it owns the heading ids, under one rule for all five: `<section>-heading`.
 * No component here reads a tone or invents an id.
 *
 * The reference site's "Delivering Precision BIM & Revit Modeling" section is
 * deliberately absent; it was cut in the scope. So are the certification row
 * and the accent closing band: the footer already carries the badges, and the
 * page now ends on the project showcase. The company overview band was
 * removed as well (2026-09-22), so the intro band leads straight into the
 * services.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/ui/Section.astro';
import Hero from '../components/home/Hero.astro';
import ServiceCard from '../components/home/ServiceCard.astro';
import IntroBand from '../components/home/IntroBand.astro';
import PresenceBand from '../components/ui/PresenceBand.astro';
import ProjectShowcase from '../components/home/ProjectShowcase.astro';
import { resolveLocale } from '../i18n/locales';
import { getHomePage, getProjects, getStats } from '../lib/content';

const lang = resolveLocale(Astro.currentLocale);

const [home, stats, projects] = await Promise.all([
  getHomePage(lang),
  getStats(lang),
  getProjects(lang),
]);

/**
 * The showcase shows the first three projects by `order` (spec 0005), so an
 * editor reorders it by editing `order`, never this file.
 */
const FEATURED_PROJECTS_COUNT = 3;
const featuredProjects = projects.slice(0, FEATURED_PROJECTS_COUNT);

/**
 * The services row's grid for one, two, or three cards (spec 0013). Three
 * fill today's row. With fewer, each card keeps the width it has in a row of
 * three and the set sits centred, never leaving an empty cell on one side: a
 * card spanning two of six columns is exactly as wide as one of three with
 * the same gap, and the first card's start column centres the set. At `md`
 * one card spans two of four columns, its width in the two column row.
 */
const SERVICE_ROWS = {
  1: {
    grid: 'grid grid-cols-1 gap-6 md:grid-cols-4 lg:grid-cols-6 lg:gap-16',
    first: 'md:col-span-2 md:col-start-2 lg:col-span-2 lg:col-start-3',
    rest: undefined,
  },
  2: {
    grid: 'grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-6 lg:gap-16',
    first: 'lg:col-span-2 lg:col-start-2',
    rest: 'lg:col-span-2',
  },
  3: {
    grid: 'grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-16',
    first: undefined,
    rest: undefined,
  },
} as const;

const featuredServices = home.services.featured;
/** The schema allows one to three, so anything else is three. */
const serviceRow =
  featuredServices.length === 1
    ? SERVICE_ROWS[1]
    : featuredServices.length === 2
      ? SERVICE_ROWS[2]
      : SERVICE_ROWS[3];
---

<PageLayout title={home.seo.title} description={home.seo.description}>
  {/**
   * 1. Hero. Its own full bleed photo band, not a Section tone, and the only
   * band on the site that slides up under the header card.
   */}
  <Hero
    heading={home.hero.heading}
    headingId="hero-heading"
    subheading={home.hero.subheading}
    images={home.hero.images.map((image) => ({
      src: image.src,
      alt: image.alt ?? '',
    }))}
    primaryCta={home.hero.primaryCta}
  />

  {/**
   * 2. Intro. Its own `canvas` band, not a Section tone, holding the
   * site's numbers as cards. That is why there is no separate stats band on
   * this page: the same figures twice would read as a mistake.
   */}
  <IntroBand
    heading={home.intro.heading}
    headingHighlight={home.intro.headingHighlight}
    headingId="intro-heading"
    lead={home.intro.lead}
    paragraphs={home.intro.paragraphs}
    stats={stats}
    lang={lang}
  />

  {/**
   * 3. Services. The ones `home.services.featured` lists, one to three, in
   * that order (spec 0013), so a new service reaches this row only when it is
   * listed, and the row never reflows into something nobody chose. The path
   * is `/${slug}`, the same one `[service].astro` builds its route from.
   */}
  <Section tone="raised" labelledBy="services-heading">
    {/**
     * A centred heading with an accent rule under it, the same treatment as the
     * intro band, then a centred intro. The rule comes from the shared
     * `heading-rule` utility in `global.css`, and `inline-block` keeps it
     * exactly as wide as the words. `data-heading-rule` is the hook
     * `reveal.ts` reads to draw it with the scroll direction.
     */}
    <div class="mx-auto max-w-narrow text-center" data-reveal>
      <h2
        id="services-heading"
        class="heading-rule inline-block"
        data-heading-rule
      >
        {home.services.heading}
      </h2>
      <p class="mt-8 text-lead">{home.services.intro}</p>
    </div>

    <div class:list={['mt-12', serviceRow.grid]} data-reveal-stagger>
      {/**
       * Each card stays a direct child of the stagger grid, so the reveal
       * moves the cards one by one rather than a wrapper as one block.
       */}
      {featuredServices.map((service, index) => (
        <ServiceCard
          class={index === 0 ? serviceRow.first : serviceRow.rest}
          title={service.title}
          summary={service.summary}
          subServices={service.subServices}
          href={`/${service.slug}`}
          illustration={{
            src: home.services.illustration.src,
            alt: home.services.illustration.alt ?? '',
          }}
          cue={home.services.cardCue}
        />
      ))}
    </div>
  </Section>

  {/**
   * 4. Global presence. A `canvas` band under a faint diagonal
   * stripe, holding the map, the copy, and the why choose list that used to
   * be its own differentiators section.
   */}
  <Section tone="canvas" labelledBy="presence-heading" class="bg-diagonal">
    <PresenceBand
      heading={home.presence.heading}
      headingId="presence-heading"
      paragraphs={home.presence.paragraphs}
      regions={home.presence.regions}
      whyChoose={home.presence.whyChoose}
    />
  </Section>

  {/**
   * 5. Project showcase. `raised`, so the tones still alternate after
   * the patterned presence band. It is the last band before the footer,
   * and it is left out entirely when the language has no projects.
   */}
  {featuredProjects.length > 0 && (
    <Section tone="raised" labelledBy="project-showcase-heading">
      <ProjectShowcase
        heading={home.projectShowcase.heading}
        headingId="project-showcase-heading"
        intro={home.projectShowcase.intro}
        projects={featuredProjects}
        cue={home.projectShowcase.cue}
        link={home.projectShowcase.link}
      />
    </Section>
  )}
</PageLayout>

{/**
 * The scroll reveal (spec 0005) is the page's choice, not a component's, so
 * it is imported here. The `data-reveal` and `data-reveal-stagger` attributes
 * the bands carry do nothing on a page that does not import it.
 */}
<script>
  import '../scripts/reveal';
</script>
