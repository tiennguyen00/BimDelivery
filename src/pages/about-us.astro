---
/**
 * About & Services (2026-10-11, replacing spec 0010's three bands): the old
 * About page and the services overview in one page, every word and photo of
 * it from the `about` entry and the services it names.
 *
 * 1. The company: its name as the `h1`, copy at the start, photo at the end.
 * 2. Experience and services: the same band, flipped.
 * 3. The services overview (2026-10-29): the client's facts, as tiles on a
 *    `raised` band, where the button above lands.
 * 4. One band per service, the sides still alternating. A service with a
 *    page links to it; one with no page yet has no button.
 * 5. The media band, kept for the company's diagrams, photos, or videos. It
 *    is an empty frame and carries no copy until they arrive.
 *
 * This file is the only place that knows the page's shape. It owns each
 * band's id and heading id, and where each button leads: down to the next
 * band, or out to a service's page.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/ui/Section.astro';
import SplitBand from '../components/about/SplitBand.astro';
import ServicesOverview from '../components/about/ServicesOverview.astro';
import { resolveLocale } from '../i18n/locales';
import { getAboutPage } from '../lib/content';

const lang = resolveLocale(Astro.currentLocale);
const about = await getAboutPage(lang);

const EXPERIENCE_ID = 'experience';
const SERVICES_ID = 'services';

const photo = (image: { src: string; alt?: string }) => ({
  src: image.src,
  alt: image.alt ?? '',
});

/**
 * The service bands follow the experience band, which puts its photo at the
 * start, so the first service band puts it at the end and they alternate.
 */
const serviceSide = (index: number): 'start' | 'end' =>
  index % 2 === 0 ? 'end' : 'start';
---

<PageLayout title={about.seo.title} description={about.seo.description}>
  <SplitBand
    headingLevel={1}
    heading={about.intro.heading}
    headingId="about-heading"
    tagline={about.intro.tagline}
    paragraphs={about.intro.paragraphs}
    lists={about.intro.lists}
    image={photo(about.intro.image)}
    imageSide="end"
    action={{
      label: about.intro.cta,
      href: `#${EXPERIENCE_ID}`,
      icon: 'arrow-down',
    }}
    motion="entrance"
  />

  <SplitBand
    id={EXPERIENCE_ID}
    headingLevel={2}
    heading={about.experience.heading}
    headingId="experience-heading"
    tagline={about.experience.tagline}
    paragraphs={about.experience.paragraphs}
    lists={about.experience.lists}
    image={photo(about.experience.image)}
    imageSide="start"
    action={{
      label: about.experience.cta,
      href: `#${SERVICES_ID}`,
      icon: 'arrow-down',
    }}
    motion="reveal"
  />

  <div id={SERVICES_ID}>
    <Section tone="raised" labelledBy="services-heading">
      <ServicesOverview
        heading={about.services.heading}
        headingId="services-heading"
        intro={about.services.intro}
        facts={about.services.facts}
      />
    </Section>

    {about.services.items.map((service, index) => (
      <SplitBand
        headingLevel={2}
        heading={service.title}
        headingId={`service-${index + 1}-heading`}
        tagline={service.tagline}
        paragraphs={[service.text]}
        image={service.image}
        imageSide={serviceSide(index)}
        action={
          service.href
            ? {
                label: about.services.cue,
                href: service.href,
                icon: 'arrow-right',
              }
            : undefined
        }
        motion="reveal"
      />
    ))}
  </div>

  <!-- <Section tone="raised" id="media">
    <div class="aspect-video w-full rounded-ui bg-panel" data-reveal></div>
  </Section> -->
</PageLayout>

{/**
 * The scroll reveal (spec 0005), the page's choice as on the other pages.
 * The first band takes no `data-reveal`: it moves on load through the CSS
 * `entrance` instead, so the two never touch the same thing.
 */}
<script>
  import '../scripts/reveal';
</script>
