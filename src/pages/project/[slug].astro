---
/**
 * Every project detail page, from one route (spec 0015, bands redrawn by spec
 * 0018 after the engineer's reference): in order, then the footer. Every
 * word, number, and photo comes from the project's entry, its service, the
 * shared `projectPage` copy, or the site name, so a project page needs no
 * code edit to exist.
 *
 * 1. Hero (`SplitBand`): the title as the `h1`, the project's categories
 *    (every category of its rooms, spec 0019) as the tagline, the intro, a
 *    "Discover more" button down to the overview, and the cover photo.
 *
 * The project, its words, and its photos come from Sanity at build (spec
 * 0019); the photos load from Sanity's image CDN, so the page opens that
 * connection early.
 * 2. Overview: the portrait photo beside the tagline, the title, and the
 *    facts.
 * 3. The rooms, one Coffee band: every room's photos in one carousel beside
 *    the room names and the work done in the room on show.
 * 4. The next project link, only when the language has two or more.
 * 5. The accent closing band, linking to Contact.
 *
 * This file sits beside `src/pages/project.astro`, which still builds
 * `/project`. It owns the heading ids, under the `<band>-heading` rule.
 */
import type { GetStaticPaths } from 'astro';
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/ui/Section.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import SplitBand from '../../components/about/SplitBand.astro';
import ProjectOverview from '../../components/project/ProjectOverview.astro';
import ProjectRooms from '../../components/project/ProjectRooms.astro';
import NextProject from '../../components/project/NextProject.astro';
import { DEFAULT_LOCALE } from '../../i18n/locales';
import {
  getProjectPage,
  getProjects,
  getSettings,
  type Project,
} from '../../lib/content';
import {
  nextProject,
  projectFacts,
  projectHead,
  projectHref,
} from '../../lib/project-detail';
import { categoryLine } from '../../lib/project-gallery';

/**
 * As on the service route, `getStaticPaths` has no `Astro.currentLocale`, so
 * it reads the default locale, which is the whole route table today. Each
 * page gets its project and the next one as props, so the page body reads no
 * collection a second time.
 */
export const getStaticPaths = (async () => {
  const projects = await getProjects(DEFAULT_LOCALE);
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project, next: nextProject(projects, project) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
  /** Absent when the language has only this one project. */
  next?: Project;
}

const { project, next } = Astro.props;

const [page, settings] = await Promise.all([
  getProjectPage(project.lang),
  getSettings(project.lang),
]);

const { detail } = page;
const head = projectHead(project, settings.siteName);
const facts = projectFacts(project, detail, project.lang);

const OVERVIEW_ID = 'project-overview';
---

<PageLayout title={head.title} description={head.description}>
  <link slot="head" rel="preconnect" href="https://cdn.sanity.io" />

  <SplitBand
    headingLevel={1}
    heading={project.title}
    headingId="project-detail-heading"
    tagline={categoryLine(project.categories)}
    paragraphs={project.intro}
    image={project.image}
    imageSide="end"
    action={{
      label: detail.discoverLabel,
      href: `#${OVERVIEW_ID}`,
      icon: 'arrow-down',
    }}
    motion="entrance"
  />

  <Section tone="raised" id={OVERVIEW_ID} labelledBy="project-overview-heading">
    <ProjectOverview
      tagline={project.tagline}
      title={project.title}
      headingId="project-overview-heading"
      portrait={project.portrait}
      facts={facts}
    />
  </Section>

  <ProjectRooms
    heading={detail.roomsHeading}
    headingId="project-room-heading"
    workloadLabel={detail.workloadLabel}
    rooms={project.rooms}
    controls={detail.photoControls}
  />

  {next && (
    <Section tone="canvas" width="narrow">
      <NextProject
        label={detail.nextLabel}
        title={next.title}
        href={projectHref(next.slug)}
      />
    </Section>
  )}

  <CtaBand
    heading={detail.cta.heading}
    headingId="project-detail-cta-heading"
    text={detail.cta.text}
    button={detail.cta.button}
  />
</PageLayout>

{/**
 * The hero moves in on load through `SplitBand`'s CSS `entrance`. The
 * overview and the rooms band reveal on scroll (`reveal.ts`), and the
 * rooms band's arrows and words come alive through `room-carousel.ts`. The
 * next project band and the accent band do not move.
 */}
<script>
  import '../../scripts/reveal';
  import '../../scripts/room-carousel';
</script>
