---
/**
 * The FAQ, `/faq` (spec 0020, one page since 2026-11-26, after the
 * engineer's mockup): three bands, in order, then the footer. Every word
 * comes from the `faqPage` entry, so a new question is a YAML edit and no
 * edit here.
 *
 * 1. The hero: eyebrow, `h1`, and intro beside the client's photo
 *    (`FaqHero`).
 * 2. The questions on `canvas`: the search box, then every question in page
 *    order as the `Accordion`'s `list` look, each its own box, all closed,
 *    several open at once. One centred column, `max-w-4xl`, so the margins
 *    either side are equal. Each `details` carries its question's `id`, so
 *    `/faq#<id>` jumps to it even with JavaScript off.
 * 3. The accent closing band in its `inline` layout, linking to Contact.
 *
 * The page carries a `FAQPage` JSON-LD script built from exactly the
 * questions it shows, in the same order. This file owns the page's element
 * ids, every one starting with `faq-`, so none can meet a question's id,
 * which may not (spec 0020).
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Accordion from '../../components/ui/Accordion.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import FaqHero from '../../components/faq/FaqHero.astro';
import FaqSearch from '../../components/faq/FaqSearch.astro';
import {
  bandGutterClass,
  bandPaddingBottomClass,
  cx,
} from '../../components/ui/styles';
import { resolveLocale } from '../../i18n/locales';
import { getFaqPage } from '../../lib/content';
import { faqPageJsonLd, faqSearchText, jsonLdScript } from '../../lib/faq';

const lang = resolveLocale(Astro.currentLocale);
const page = await getFaqPage(lang);

const faqSchema = jsonLdScript(faqPageJsonLd(page.questions));
---

<PageLayout title={page.seo.title} description={page.seo.description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={faqSchema}></script>
  </Fragment>

  <FaqHero copy={page.hero} headingId="faq-heading" />

  <div class={cx('bg-canvas', bandGutterClass, bandPaddingBottomClass)}>
    <FaqSearch
      copy={page.search}
      target="faq-questions"
      inputId="faq-search"
      lang={lang}
      class="mx-auto w-full max-w-4xl"
    >
      <div id="faq-questions" class="mt-2">
        <Accordion
          variant="list"
          items={page.questions.map((question) => ({
            id: question.id,
            title: question.question,
            text: question.answer,
            hooks: {
              'data-faq-item': '',
              'data-faq-text': faqSearchText(
                question.question,
                question.answer,
              ),
            },
          }))}
        />
      </div>
    </FaqSearch>
  </div>

  <CtaBand
    layout="inline"
    heading={page.cta.heading}
    headingId="faq-cta-heading"
    text={page.cta.text}
    button={page.cta.button}
  />
</PageLayout>

{/**
 * Motion: a question slides open and shut through `accordion-item`, and
 * nothing moves on load. The hero's words are there at first paint. The
 * search and the questions stay still on purpose: a linked question (`#id`)
 * is scrolled into place while the page loads, and a column still rising
 * would leave it 24px off once it settles. Under reduced motion nothing
 * moves.
 *
 * The search over the questions, and opening the question a link points at
 * (`#id`), on load and on every hash change. With no script the box is
 * gone, the questions all show, and `#id` still jumps to its question,
 * closed.
 */}
<script>
  import '../../scripts/faq';
</script>
