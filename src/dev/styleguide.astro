---
/**
 * The living check on the design system (spec 0003), at /styleguide under
 * `pnpm dev` only. It is never built, so it never reaches the live site.
 *
 * Two jobs. It shows every token and every component variant in one place, so
 * a change to global.css is visible immediately rather than discovered on a
 * page later. And it is the page you walk with a keyboard and at 200% zoom
 * when checking this feature.
 *
 * The sample copy and images come from the real content collections, so the
 * components are exercised with the lengths the site actually has. The token
 * names, hex values, and contrast figures are written here on purpose: they
 * are developer labels rather than site content, and this page is never built.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import MediaText from '../components/ui/MediaText.astro';
import StatsBand from '../components/ui/StatsBand.astro';
import Accordion from '../components/ui/Accordion.astro';
import Emphasis from '../components/ui/Emphasis.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import Icon, { type IconName } from '../components/ui/Icon.astro';
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import { Button as ReactButton } from '../components/react/ui/Button';
import { TextField } from '../components/react/ui/TextField';
import { TextArea } from '../components/react/ui/TextArea';
import { Select } from '../components/react/ui/Select';
import FormBand from '../components/contact/FormBand.astro';
import ContactCard from '../components/contact/ContactCard.astro';
import PatternBand from '../components/ui/PatternBand.astro';
import FeaturesCards from '../components/service/FeaturesCards.astro';
import ProjectGallery from '../components/project/ProjectGallery.astro';
import type { BlockAt } from '../lib/service-page';
import { telHref } from '../lib/contact';
import { resolveLocale } from '../i18n/locales';
import {
  getAboutPage,
  getContactPage,
  getHomePage,
  getNavigation,
  getProjectPage,
  getProjects,
  getServices,
  getSettings,
  getStats,
} from '../lib/content';

const lang = resolveLocale(Astro.currentLocale);

const [
  home,
  services,
  projects,
  contact,
  navigation,
  settings,
  stats,
  about,
  projectPage,
] = await Promise.all([
  getHomePage(lang),
  getServices(lang),
  getProjects(lang),
  getContactPage(lang),
  getNavigation(lang),
  getSettings(lang),
  getStats(lang),
  getAboutPage(lang),
  getProjectPage(lang),
]);

/** The whole icon map, in the order Icon.astro declares it. */
const iconNames: readonly IconName[] = [
  'menu',
  'close',
  'chevron-down',
  'check',
  'arrow-right',
  'plus',
  'minus',
  'phone',
  'mail',
  'globe',
  'linkedin',
  'facebook',
  'youtube',
  'x',
  'instagram',
  'briefcase-clock',
  'users',
  'building',
  'map-pin',
  'headset',
  'envelope',
  'blueprint',
  'crane',
  'building-check',
  'scan',
  'clipboard-check',
  'ruler',
  'clash',
  'layers',
  'messages',
  'user',
  'presenter',
  'compass',
  'hard-hat',
  'users-gear',
];

/** The service pages' line glyphs, for the `strokeWidth` row. */
const lineIconNames: readonly IconName[] = [
  'blueprint',
  'crane',
  'building-check',
  'scan',
  'clipboard-check',
  'ruler',
  'clash',
  'layers',
  'messages',
];

const firstService = services[0];
const secondService = services[1];
const firstProject = projects[0];

/**
 * The first service's intro photo and closing call to action (spec 0013),
 * for the `Card` and `CtaBand` tiles. Every service opens with an intro, but
 * a `process` block is optional, so the `CtaBand` tile is skipped when the
 * service has none.
 */
const firstServicePhoto = firstService?.sections.find(
  (block) => block.type === 'intro',
)?.images[0];
const firstServiceCta = firstService?.sections.find(
  (block) => block.type === 'process',
)?.cta;

/**
 * The first features block drawn as cards, for the `PatternBand` tiles. The
 * same block is shown on both surfaces, so the tile proves that only the
 * `surface` field changes how a band looks.
 */
const cardsBlock = services
  .flatMap((service) => service.sections)
  .find(
    (block): block is BlockAt<'features/cards'> =>
      block.type === 'features' && block.layout === 'cards',
  );

/**
 * Every swatch carries what the colour is for and what it must never be,
 * because the two golds look alike in a list and only one of them is legible
 * as a word.
 */
const colours = [
  {
    token: '--color-white',
    swatch: 'bg-white',
    hex: '#ffffff',
    use: 'Page background, card surface; text on the scrim; the ring outer band',
    avoid: 'Text anywhere but on the scrim',
  },
  {
    token: '--color-tint',
    swatch: 'bg-tint',
    hex: '#fff9e6',
    use: 'The tint section background',
    avoid: 'Text',
  },
  {
    token: '--color-black',
    swatch: 'bg-black',
    hex: '#000000',
    use: 'h1 and h2; the label on any gold or yellow fill',
    avoid: 'Nothing',
  },
  {
    token: '--color-ink-strong',
    swatch: 'bg-ink-strong',
    hex: '#333333',
    use: 'h3, field labels, strong text',
    avoid: 'Nothing',
  },
  {
    token: '--color-ink',
    swatch: 'bg-ink',
    hex: '#666666',
    use: 'Body text, the most used text colour on the site',
    avoid: 'Nothing',
  },
  {
    token: '--color-ink-muted',
    swatch: 'bg-ink-muted',
    hex: '#707070',
    use: 'Hints, captions, card text',
    avoid: 'Long body copy (it sits at the 4.5:1 floor)',
  },
  {
    token: '--color-gold',
    swatch: 'bg-gold',
    hex: '#e09900',
    use: 'FILLS ONLY: primary button, highlight fills, decorative rules',
    avoid: 'Any text, any control border, any focus ring (2.41:1 on white)',
  },
  {
    token: '--color-gold-deep',
    swatch: 'bg-gold-deep',
    hex: '#c88600',
    use: 'The primary button hover fill',
    avoid: 'Everything else',
  },
  {
    token: '--color-gold-ink',
    swatch: 'bg-gold-ink',
    hex: '#946600',
    use: 'The only readable gold: words, links, control borders, focus ring',
    avoid: 'Large flat fills, where it reads muddy rather than gold',
  },
  {
    token: '--color-yellow',
    swatch: 'bg-yellow',
    hex: '#ffcc00',
    use: 'Reserved for the real logo and feature 5 icons',
    avoid: 'Any text; anything in this feature (1.51:1 on white)',
  },
  {
    token: '--color-line',
    swatch: 'bg-line',
    hex: '#e5e5e5',
    use: 'Card borders and dividers (decorative)',
    avoid: 'Any control boundary (1.26:1 on white)',
  },
  {
    token: '--color-field',
    swatch: 'bg-field',
    hex: '#767676',
    use: 'Form field borders, a control boundary at 4.54:1',
    avoid: 'Decorative lines, where it is heavier than they need',
  },
  {
    token: '--color-error',
    swatch: 'bg-error',
    hex: '#b42318',
    use: 'Error text and error borders',
    avoid: 'Decoration',
  },
  {
    token: '--color-error-on-dark',
    swatch: 'bg-error-on-dark',
    hex: '#ff9b8f',
    use: 'Error text on the contact form band (5.19:1 at its worst point)',
    avoid: 'Any light tone (2.03:1 on white)',
  },
  {
    token: '--color-scrim',
    swatch: 'bg-scrim',
    hex: 'rgb(0 0 0 / 0.6)',
    use: 'The dark panel white text sits on over a photo (the home hero)',
    avoid: 'Anything lighter: 0.6 is what keeps white text at 5.74:1',
  },
  {
    token: '--color-scrim-strong',
    swatch: 'bg-scrim-strong',
    hex: 'rgb(0 0 0 / 0.8)',
    use: 'The layer over the whole contact form band, under bg-diagonal-dark',
    avoid: 'Anything lighter: the stripe already lifts its lines to #3f3f3f',
  },
  {
    token: '--color-panel',
    swatch: 'bg-panel',
    hex: '#161616',
    use: 'A card or tile on a dark pattern band (white 18.10, gold-on-dark 7.52)',
    avoid: 'Any light tone',
  },
] as const;

const typeScale = [
  {
    token: 'text-h1',
    class: 'text-h1 font-bold text-black',
    note: '36px to 56px, line height 1.1, tracking -0.02em',
  },
  {
    token: 'text-h2',
    class: 'text-h2 font-bold text-black',
    note: '28px to 40px, line height 1.2',
  },
  {
    token: 'text-h3',
    class: 'text-h3 font-semibold text-ink-strong',
    note: '20px to 24px, line height 1.3',
  },
  {
    token: 'text-lead',
    class: 'text-lead text-ink',
    note: '18px fixed, line height 1.6',
  },
  {
    token: 'text-body',
    class: 'text-body text-ink',
    note: '16px fixed, line height 1.6',
  },
  {
    token: 'text-small',
    class: 'text-small text-ink-muted',
    note: '14px fixed, line height 1.5',
  },
] as const;

const contrastPairs = [
  { pair: 'black on white / tint', ratio: '21.00 / 19.94', needs: '4.5' },
  { pair: 'ink-strong on white / tint', ratio: '12.63 / 12.00', needs: '4.5' },
  { pair: 'ink on white / tint', ratio: '5.74 / 5.45', needs: '4.5' },
  { pair: 'ink-muted on white / tint', ratio: '4.95 / 4.70', needs: '4.5' },
  { pair: 'gold-ink on white / tint', ratio: '5.05 / 4.79', needs: '4.5' },
  { pair: 'black on gold / gold-deep', ratio: '8.73 / 6.87', needs: '4.5' },
  { pair: 'black on yellow', ratio: '13.89', needs: '4.5' },
  { pair: 'field border on white / tint', ratio: '4.54 / 4.31', needs: '3.0' },
  { pair: 'error on white / tint', ratio: '6.57 / 6.24', needs: '4.5' },
  {
    pair: 'focus ring gold-ink on white / tint',
    ratio: '5.05 / 4.79',
    needs: '3.0',
  },
  {
    pair: 'white on black / ink-strong (the gold band link)',
    ratio: '21.00 / 12.63',
    needs: '4.5',
  },
  {
    pair: 'black on gold (the gold band heading and text)',
    ratio: '8.73',
    needs: '4.5',
  },
  {
    pair: 'white on the scrim over any photo (worst case: over pure white)',
    ratio: '5.74 at worst',
    needs: '4.5',
  },
  {
    pair: 'white on the contact form band (scrim-strong plus a stripe line over pure white)',
    ratio: '10.5 at worst',
    needs: '4.5',
  },
  {
    pair: 'error-on-dark on the contact form band, the same worst case',
    ratio: '5.19 at worst',
    needs: '4.5',
  },
  {
    pair: 'white on the dark pattern band (a dot centre, #242424) / on a panel',
    ratio: '15.52 / 18.10',
    needs: '4.5',
  },
  {
    pair: 'gold-on-dark on the dark pattern band (a dot centre) / on a panel',
    ratio: '6.45 / 7.52',
    needs: '4.5',
  },
  {
    pair: 'two colour focus ring, black inside and white outside (the hero photo, the gold band)',
    ratio: '8.73 on gold; at least 4.58 on any colour',
    needs: '3.0',
  },
] as const;

const spacingSteps = [
  { token: 'gap-2', px: '8px', use: 'Inside a card body' },
  { token: 'gap-4 / px-4', px: '16px', use: 'Mobile gutters, grid gaps' },
  { token: 'md:px-6', px: '24px', use: 'Tablet gutters' },
  { token: 'lg:px-8', px: '32px', use: 'Desktop gutters' },
  { token: 'p-6', px: '24px', use: 'Card padding' },
  { token: 'py-16', px: '64px', use: 'Mobile section padding' },
  { token: 'md:py-20', px: '80px', use: 'Tablet section padding' },
  { token: 'lg:py-24', px: '96px', use: 'Desktop section padding' },
] as const;

const cellClass = 'border-b border-line px-3 py-2 align-top';
const headCellClass =
  'border-b border-field px-3 py-2 text-left font-semibold text-ink-strong';
---

<BaseLayout
  title="Style guide"
  description="Every design token and component variant in the BIM Delivery design system, for development only."
>
  <main>
    <Section tone="tint" labelledBy="sg-title">
      <p class="text-small font-semibold tracking-wide text-gold-ink uppercase">
        Development only
      </p>
      <h1 id="sg-title" class="mt-2">
        Design system
      </h1>
      <p class="mt-4 max-w-narrow text-lead">
        Every token and every component variant in one place. This page is
        injected by a dev only integration, so it never reaches a build. Walk it
        with a keyboard and at 200% zoom when checking this feature.
      </p>
    </Section>

    <Section labelledBy="sg-colour">
      <h2 id="sg-colour">Colour</h2>
      <p class="mt-4 max-w-narrow">
        Tailwind's own palette is switched off, so these are the only colours
        that exist. Every one is named for its role rather than its hue, which
        is what makes a real brand later a change of values rather than a change
        of class names everywhere.
      </p>

      <ul class="mt-8 grid list-none grid-cols-1 gap-6 p-0 md:grid-cols-2 lg:grid-cols-3">
        {colours.map((colour) => (
          <li class="flex flex-col gap-3 rounded-ui border border-line p-4">
            <div
              class:list={[
                'h-20 w-full rounded-ui border border-line',
                colour.swatch,
              ]}
            />
            <div class="flex flex-col gap-1">
              <code class="font-mono text-small font-semibold text-ink-strong">
                {colour.token}
              </code>
              <code class="font-mono text-small text-ink-muted">
                {colour.hex}
              </code>
            </div>
            <dl class="flex flex-col gap-1 text-small">
              <div>
                <dt class="inline font-semibold text-ink-strong">Use: </dt>
                <dd class="inline text-ink">{colour.use}</dd>
              </div>
              <div>
                <dt class="inline font-semibold text-error">Never: </dt>
                <dd class="inline text-ink">{colour.avoid}</dd>
              </div>
            </dl>
          </li>
        ))}
      </ul>
    </Section>

    <Section tone="tint" labelledBy="sg-gold">
      <h2 id="sg-gold">The gold rule</h2>
      <p class="mt-4 max-w-narrow">
        This is the one convention the build cannot catch for you. Gold splits
        in two: a fill gold and a text gold. They look alike in a swatch list,
        and only one of them is legible as a word.
      </p>

      <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
        <div class="rounded-ui border border-line bg-white p-6">
          <h3>Right</h3>
          <p class="mt-3">
            A <span class="font-semibold text-gold-ink">gold word</span> and a{' '}
            <a href="#sg-gold" class="font-semibold text-gold-ink underline">
              gold link
            </a>{' '}
            both use <code class="font-mono text-small">gold-ink</code> at
            5.05:1.
          </p>
          <p class="mt-3">The fill gold carries a black label:</p>
          <p class="mt-3 inline-block rounded-ui bg-gold px-4 py-2 font-semibold text-black">
            Black on gold, 8.73:1
          </p>
        </div>

        <div class="rounded-ui border border-error bg-white p-6">
          <h3>Wrong</h3>
          <p class="mt-3">
            The fill gold <code class="font-mono text-small">--color-gold</code>{' '}
            on white is 2.41:1, and the accent{' '}
            <code class="font-mono text-small">--color-yellow</code> is 1.51:1.
            Both fail WCAG AA at every text size, so neither is ever a word, a
            link, a control border, or a focus ring.
          </p>
          <p class="mt-3 text-small text-ink">
            Two things are avoided here on purpose. The failing pairs are not
            rendered as text, which would put a failing pair on the page. And
            their utility class names are not written out either: Tailwind reads
            source files as plain text, so a class name quoted in prose becomes
            real CSS and would also trip the gold guard search.
          </p>
        </div>
      </div>

      <h3 class="mt-12">The heading rule</h3>
      <p class="mt-3 max-w-narrow">
        One utility, <code class="font-mono text-small">heading-rule</code>,
        draws the gold line under every section heading. The line is a pseudo
        element, so it is exactly as wide as the heading's own box and never
        reaches a screen reader, and{' '}
        <code class="font-mono text-small">display</code> is left to the call
        site.
      </p>

      <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
        <div class="rounded-ui border border-line bg-white p-6">
          <h4 class="heading-rule inline-block text-h3 font-bold text-black">
            On a light tone
          </h4>
          <p class="mt-6 text-small text-ink">
            The heading sets{' '}
            <code class="font-mono text-small">inline-block</code>, so the line
            hugs the words rather than the column.
          </p>
        </div>

        <div class="focus-contrast rounded-ui bg-black p-6">
          <div class="flex justify-center">
            <h4 class="heading-rule text-center text-h3 font-bold text-white">
              On the black band
            </h4>
          </div>
          <p class="mt-6 text-small text-white">
            The heading is a flex item here, so it sets no display of its own
            and the line still fits the words.
          </p>
        </div>
      </div>

      <p class="mt-6 max-w-narrow text-small text-ink">
        This page does not import the reveal script, so both rules are still,
        which is what the class alone gives you. On a page that does import it,
        a heading also marked with the{' '}
        <code class="font-mono text-small">data-heading-rule</code> attribute
        draws its line as the visitor scrolls down and takes it back as they
        scroll up.
      </p>
    </Section>

    <Section labelledBy="sg-type">
      <h2 id="sg-type">Type</h2>
      <p class="mt-4 max-w-narrow">
        Inter, served from this site's own origin. Headings grow smoothly with
        the viewport rather than jumping at a breakpoint. Line height and letter
        spacing ride on the size token, so{' '}
        <code class="font-mono text-small">text-h1</code> is the whole treatment
        and no component ever repeats them.
      </p>

      <dl class="mt-8 flex flex-col gap-8">
        {typeScale.map((entry) => (
          <div class="border-t border-line pt-6">
            <dt class="flex flex-wrap items-baseline gap-3">
              <code class="font-mono text-small font-semibold text-ink-strong">
                {entry.token}
              </code>
              <span class="text-small text-ink-muted">{entry.note}</span>
            </dt>
            <dd class:list={['mt-3', entry.class]}>
              Precision BIM and Revit modelling
            </dd>
          </div>
        ))}
      </dl>
    </Section>

    <Section tone="tint" labelledBy="sg-space">
      <h2 id="sg-space">Spacing, widths, and breakpoints</h2>

      <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-2">
        <div>
          <h3>Spacing in use</h3>
          <div class="mt-4 overflow-x-auto">
            <table class="w-full border-collapse text-small">
              <thead>
                <tr>
                  <th class={headCellClass} scope="col">
                    Utility
                  </th>
                  <th class={headCellClass} scope="col">
                    Size
                  </th>
                  <th class={headCellClass} scope="col">
                    Where
                  </th>
                </tr>
              </thead>
              <tbody>
                {spacingSteps.map((step) => (
                  <tr>
                    <td class={cellClass}>
                      <code class="font-mono">{step.token}</code>
                    </td>
                    <td class={cellClass}>{step.px}</td>
                    <td class={cellClass}>{step.use}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div>
          <h3>Widths and breakpoints</h3>
          <div class="mt-4 overflow-x-auto">
            <table class="w-full border-collapse text-small">
              <thead>
                <tr>
                  <th class={headCellClass} scope="col">
                    Token
                  </th>
                  <th class={headCellClass} scope="col">
                    Value
                  </th>
                  <th class={headCellClass} scope="col">
                    Meaning
                  </th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class={cellClass}>
                    <code class="font-mono">max-w-content</code>
                  </td>
                  <td class={cellClass}>1200px</td>
                  <td class={cellClass}>Section width "default"</td>
                </tr>
                <tr>
                  <td class={cellClass}>
                    <code class="font-mono">max-w-narrow</code>
                  </td>
                  <td class={cellClass}>720px</td>
                  <td class={cellClass}>Section width "narrow", for reading</td>
                </tr>
                <tr>
                  <td class={cellClass}>
                    <code class="font-mono">(none)</code>
                  </td>
                  <td class={cellClass}>0 to 767px</td>
                  <td class={cellClass}>Mobile, the unprefixed default</td>
                </tr>
                <tr>
                  <td class={cellClass}>
                    <code class="font-mono">md:</code>
                  </td>
                  <td class={cellClass}>768px and up</td>
                  <td class={cellClass}>Tablet</td>
                </tr>
                <tr>
                  <td class={cellClass}>
                    <code class="font-mono">lg:</code>
                  </td>
                  <td class={cellClass}>1024px and up</td>
                  <td class={cellClass}>Desktop</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="mt-4 text-small text-ink">
            <code class="font-mono">sm</code>, <code class="font-mono">xl</code>
            , and <code class="font-mono">2xl</code> are switched off. Three
            screens is the whole system.
          </p>
        </div>
      </div>
    </Section>

    <Section width="narrow" labelledBy="sg-narrow">
      <h2 id="sg-narrow" class="text-h3">
        A narrow band, 720px
      </h2>
      <p class="mt-3">
        This is the reading width for long copy, such as the privacy page. The
        default width is 1200px and is what most sections use. The band itself
        is still full width; only its content is held in.
      </p>
    </Section>

    <Section tone="tint" labelledBy="sg-buttons">
      <h2 id="sg-buttons">Buttons</h2>
      <p class="mt-4 max-w-narrow">
        Two variants, at least 44px tall, identical on white and on tint. A
        button with <code class="font-mono text-small">href</code> renders an
        anchor, so middle click and open in a new tab work; without one it
        renders a real button. Labels always arrive from content.
      </p>

      <h3 class="mt-8">On tint</h3>
      <div class="mt-4 flex flex-wrap items-center gap-4">
        <Button href={home.hero.primaryCta.href}>
          {home.hero.primaryCta.label}
        </Button>
        <Button variant="secondary" href={home.hero.primaryCta.href}>
          {home.hero.primaryCta.label}
        </Button>
        <Button type="submit">{contact.form.submitLabel}</Button>
        <Button variant="secondary" disabled>
          {contact.form.submitLabel}
        </Button>
      </div>

      <h3 class="mt-8">React, sharing the same class map</h3>
      <div class="mt-4 flex flex-wrap items-center gap-4">
        <ReactButton>{contact.form.submitLabel}</ReactButton>
        <ReactButton variant="secondary">
          {contact.form.submitLabel}
        </ReactButton>
        <ReactButton disabled>{contact.form.submitLabel}</ReactButton>
      </div>
    </Section>

    <Section labelledBy="sg-buttons-white">
      <h2 id="sg-buttons-white" class="text-h3">
        The same buttons on white
      </h2>
      <div class="mt-4 flex flex-wrap items-center gap-4">
        <Button href={home.hero.primaryCta.href}>
          {home.hero.primaryCta.label}
        </Button>
        <Button variant="secondary" href={home.hero.primaryCta.href}>
          {home.hero.primaryCta.label}
        </Button>
        <Button disabled>{contact.form.submitLabel}</Button>
      </div>
      <p class="mt-4 text-small text-ink">
        Nothing changed. Both tones are light, so no component adapts to its
        background and none takes a tone prop.
      </p>
    </Section>

    <Section tone="tint" labelledBy="sg-cards">
      <h2 id="sg-cards">Cards</h2>
      <p class="mt-4 max-w-narrow">
        One link, one tab stop, and the whole card is clickable. Keyboard focus
        draws a single ring around the card; hover is a raised shadow and an
        underlined title, so a mouse user is never shown something that reads as
        a focus ring.
      </p>

      <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {firstService && (
          <Card
            title={firstService.title}
            text={firstService.summary}
            image={
              firstServicePhoto && {
                src: firstServicePhoto.src,
                alt: firstServicePhoto.alt ?? '',
              }
            }
            href={`/${firstService.slug}`}
          />
        )}
        {firstProject && (
          <Card
            title={firstProject.title}
            text={firstProject.summary}
            image={{
              src: firstProject.image.src,
              alt: firstProject.image.alt ?? '',
            }}
          />
        )}
        {secondService && (
          <Card
            title={`${secondService.title} for federated models, clash detection, and fully coordinated delivery across every discipline`}
            text={secondService.summary}
            href={`/${secondService.slug}`}
          />
        )}
      </div>

      <h3 class="mt-12">Text only, with no image and no link</h3>
      <div class="mt-4 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {services.slice(0, 3).map((service) => (
          <Card title={service.title} text={service.summary} />
        ))}
      </div>
    </Section>

    <Section labelledBy="sg-cards-white">
      <h2 id="sg-cards-white" class="text-h3">
        The same cards on white
      </h2>
      <div class="mt-4 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {firstService && (
          <Card
            title={firstService.title}
            text={firstService.summary}
            image={
              firstServicePhoto && {
                src: firstServicePhoto.src,
                alt: firstServicePhoto.alt ?? '',
              }
            }
            href={`/${firstService.slug}`}
          />
        )}
        {firstProject && (
          <Card
            title={firstProject.title}
            text={firstProject.summary}
            image={{
              src: firstProject.image.src,
              alt: firstProject.image.alt ?? '',
            }}
          />
        )}
        {secondService && (
          <Card title={secondService.title} text={secondService.summary} />
        )}
      </div>
      <p class="mt-4 text-small text-ink">
        The card keeps its own white surface and its own border on either tone,
        so the only thing that changed is the band behind it.
      </p>
    </Section>

    <Section tone="tint" labelledBy="sg-fields">
      <h2 id="sg-fields">Form fields</h2>
      <p class="mt-4 max-w-narrow">
        Labels are always visible, so no placeholder stands in for one. An error
        never relies on colour: the control gets{' '}
        <code class="font-mono text-small">aria-invalid</code>, the message is
        linked through{' '}
        <code class="font-mono text-small">aria-describedby</code>, and the
        outline thickens through an inset ring so nothing shifts.
      </p>
      <p class="mt-3 max-w-narrow text-small text-ink">
        Each field here passes an explicit id, because a field placed straight
        into an .astro file renders as its own React root and generated ids can
        repeat across roots. Inside one island the generated id is enough.
      </p>

      <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-2">
        <div class="flex flex-col gap-6">
          <TextField
            id="sg-name"
            name="name"
            label={contact.form.labels.name}
            required
          />
          <TextField
            id="sg-email"
            name="email"
            type="email"
            label={contact.form.labels.email}
          />
          <TextField
            id="sg-company"
            name="company"
            label={contact.form.labels.company}
            hint={contact.form.optionalHint}
          />
        </div>

        <div class="flex flex-col gap-6">
          <TextField
            id="sg-email-invalid"
            name="email-invalid"
            type="email"
            label={contact.form.labels.email}
            error={contact.errors.email}
            defaultValue="not-an-email"
          />
          <TextField
            id="sg-name-invalid"
            name="name-invalid"
            label={contact.form.labels.name}
            hint={contact.form.optionalHint}
            error={contact.errors.required}
          />
          <TextArea
            id="sg-message"
            name="message"
            label={contact.form.labels.message}
            rows={4}
          />
        </div>
      </div>
    </Section>

    <Section labelledBy="sg-fields-white">
      <h2 id="sg-fields-white" class="text-h3">
        The same fields on white
      </h2>
      <div class="mt-4 grid grid-cols-1 gap-8 lg:grid-cols-2">
        <div class="flex flex-col gap-6">
          <TextField
            id="sg-white-name"
            name="white-name"
            label={contact.form.labels.name}
            required
          />
          <TextField
            id="sg-white-company"
            name="white-company"
            label={contact.form.labels.company}
            hint={contact.form.optionalHint}
          />
        </div>

        <div class="flex flex-col gap-6">
          <TextField
            id="sg-white-email-invalid"
            name="white-email-invalid"
            type="email"
            label={contact.form.labels.email}
            error={contact.errors.email}
            defaultValue="not-an-email"
          />
          <TextArea
            id="sg-white-message"
            name="white-message"
            label={contact.form.labels.message}
            rows={4}
          />
        </div>
      </div>
      <p class="mt-4 text-small text-ink">
        The field keeps its white fill and its{' '}
        <code class="font-mono text-small">--color-field</code> border on either
        tone, so the control boundary clears 3:1 on both.
      </p>
    </Section>

    <Section tone="tint" labelledBy="sg-contrast">
      <h2 id="sg-contrast">Contrast</h2>
      <p class="mt-4 max-w-narrow">
        Every pair the site actually renders, with its measured ratio. The full
        tables, including the three values that are deliberately never text, are
        in <code class="font-mono text-small">docs/design.md</code>.
      </p>

      <div class="mt-8 overflow-x-auto">
        <table class="w-full border-collapse text-small">
          <thead>
            <tr>
              <th class={headCellClass} scope="col">
                Pair
              </th>
              <th class={headCellClass} scope="col">
                Ratio
              </th>
              <th class={headCellClass} scope="col">
                Needs
              </th>
            </tr>
          </thead>
          <tbody>
            {contrastPairs.map((pair) => (
              <tr>
                <td class={cellClass}>{pair.pair}</td>
                <td class={cellClass}>
                  <code class="font-mono">{pair.ratio}</code>
                </td>
                <td class={cellClass}>{pair.needs}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Section>
    <Section labelledBy="sg-icons">
      <h2 id="sg-icons">Icons</h2>
      <p class="mt-4 max-w-narrow">
        The whole set. There is no icon library: a couple of dozen glyphs is not
        enough to earn a dependency, and a fixed map means a name outside it is
        a type error rather than a blank square. Every glyph inherits{' '}
        <code class="font-mono text-small">currentColor</code>, so the two rows
        below are the same glyphs.
      </p>

      <ul class="mt-8 grid list-none grid-cols-2 gap-4 p-0 md:grid-cols-4 lg:grid-cols-6">
        {iconNames.map((name) => (
          <li class="flex flex-col items-center gap-2 rounded-ui border border-line p-4">
            <Icon name={name} />
            <code class="font-mono text-small text-ink-muted">{name}</code>
          </li>
        ))}
      </ul>

      <p class="mt-8">Inheriting the colour of the text around them:</p>
      <ul class="mt-4 flex list-none flex-wrap gap-4 p-0 text-gold-ink">
        {iconNames.map((name) => (
          <li>
            <Icon name={name} size={20} />
          </li>
        ))}
      </ul>

      <h3 class="mt-12">The service line glyphs and strokeWidth</h3>
      <p class="mt-3 max-w-narrow text-small text-ink">
        Copied from Tabler Icons (MIT); the solid audience glyphs come from
        Tabler filled or Material Icons (Apache 2.0). At 80px a 2 unit stroke is
        nearly 7px thick, so a features card passes{' '}
        <code class="font-mono text-small">strokeWidth</code> 1.25 and a tile
        1.5. The rows below are 80px at 1.25, then 40px at 1.5.
      </p>
      <ul class="mt-6 flex list-none flex-wrap gap-6 p-0 text-gold-ink">
        {lineIconNames.map((name) => (
          <li>
            <Icon name={name} size={80} strokeWidth={1.25} />
          </li>
        ))}
      </ul>
      <ul class="mt-6 flex list-none flex-wrap gap-6 p-0 text-gold-ink">
        {lineIconNames.map((name) => (
          <li>
            <Icon name={name} size={40} strokeWidth={1.5} />
          </li>
        ))}
      </ul>
    </Section>

    <Section tone="tint" labelledBy="sg-pattern-intro">
      <h2 id="sg-pattern-intro">Pattern bands</h2>
      <p class="mt-4 max-w-narrow">
        <code class="font-mono text-small">PatternBand</code> is the surface of
        the service pages' features and process bands (spec 0013), named by the
        content's <code class="font-mono text-small">surface</code> field.{' '}
        <code class="font-mono text-small">dark</code> is black under{' '}
        <code class="font-mono text-small">bg-dots-dark</code>, whose lightest
        pixel is #242424, with{' '}
        <code class="font-mono text-small">--color-panel</code> cards;{' '}
        <code class="font-mono text-small">light</code> is white under the
        diagonal stripe.
      </p>
      <p class="mt-3 max-w-narrow text-small text-ink">
        Both bands below draw the same Revit Modeling features block through the
        real <code class="font-mono text-small">FeaturesCards</code>; only its{' '}
        <code class="font-mono text-small">surface</code> differs. The dark band
        carries <code class="font-mono text-small">focus-contrast</code>. This
        page does not import the reveal script, so nothing moves.
      </p>
    </Section>

    {cardsBlock && (
      <>
        <PatternBand surface="dark" labelledBy="sg-pattern-dark-heading">
          <FeaturesCards
            block={{ ...cardsBlock, surface: 'dark' }}
            headingId="sg-pattern-dark-heading"
          />
        </PatternBand>
        <PatternBand surface="light" labelledBy="sg-pattern-light-heading">
          <FeaturesCards
            block={{ ...cardsBlock, surface: 'light' }}
            headingId="sg-pattern-light-heading"
          />
        </PatternBand>
      </>
    )}

    <Section tone="tint" labelledBy="sg-shell">
      <h2 id="sg-shell">The site shell</h2>
      <p class="mt-4 max-w-narrow">
        The real <code class="font-mono text-small">Header</code> and{' '}
        <code class="font-mono text-small">Footer</code>, from the real
        navigation entry. They are shown here in the state a visitor with no
        JavaScript sees, because this page imports{' '}
        <code class="font-mono text-small">BaseLayout</code> directly and so
        never gets the <code class="font-mono text-small">js</code> flag that
        closes the panels. Both the services dropdown and the mobile menu are
        open below, and every link is reachable. That is the baseline the nav
        script enhances, not a bug.
      </p>
      <p class="mt-4 max-w-narrow">
        The current page is set to <code class="font-mono text-small">/</code>{' '}
        so the active underline and{' '}
        <code class="font-mono text-small">aria-current</code> are visible. To
        walk the real behaviour, open any page of the site instead; the panels
        only close where the flag script runs.
      </p>

      {/* `--header-h` is declared by PageLayout, which this page does not use.
           The preview sets the same mobile value so the bar has its real
           height. If that value changes in PageLayout, change it here too. */}
      <div
        class="mt-8 overflow-hidden rounded-ui border border-line"
        style="--header-h: 4.5rem"
      >
        <Header
          items={navigation.items}
          cta={navigation.cta}
          ui={navigation.ui}
          logo={settings.logo}
          siteName={settings.siteName}
          currentPath="/"
        />
        <Footer legal={navigation.legal} settings={settings} />
      </div>

      <h3 class="mt-12">The footer with its certification panel hidden</h3>
      <p class="mt-4 max-w-narrow">
        What <code class="font-mono text-small">/about-us</code> shows (spec
        0010): that page has the badges in a band of its own, so it passes{' '}
        <code class="font-mono text-small">
          footerCertification=&#123;false&#125;
        </code>
        and the brand and contact columns share the row.
      </p>
      <div class="mt-8 overflow-hidden rounded-ui border border-line">
        <Footer
          legal={navigation.legal}
          settings={settings}
          showCertification={false}
        />
      </div>
    </Section>

    <Section tone="tint" labelledBy="sg-mediatext">
      <h2 id="sg-mediatext">Media and text</h2>
      <p class="mt-4 max-w-narrow">
        A heading, paragraphs, an optional list in the slot, and an optional
        photo beside them. The home overview uses it and About will too; when
        one page shows two, flip{' '}
        <code class="font-mono text-small">imageSide</code> so the second does
        not read as the first printed again.
      </p>

      <div class="mt-8">
        <MediaText
          heading={home.overview.heading}
          headingId="sg-mediatext-overview"
          paragraphs={home.overview.paragraphs}
          image={{
            src: home.overview.image.src,
            alt: home.overview.image.alt ?? '',
          }}
          imageSide="end"
        />
      </div>

      <h3 class="mt-12">The same component with no image</h3>
      <p class="mt-3 max-w-narrow text-small text-ink">
        The <code class="font-mono text-small">image</code> prop is optional.
        Without it the copy becomes one centred reading column rather than half
        a grid with an empty other half.
      </p>
      <div class="mt-6">
        <MediaText
          heading={home.overview.heading}
          headingId="sg-mediatext-noimage"
          paragraphs={home.overview.paragraphs}
        />
      </div>
    </Section>

    <Section labelledBy="sg-statsband">
      <h2 id="sg-statsband">Stats band</h2>
      <p class="mt-4 max-w-narrow">
        The finished numbers are rendered at build, already grouped for the
        page's language, so <code class="font-mono text-small">1200</code> reads
        as <code class="font-mono text-small">1,200</code>. The counter script
        animates them when the band scrolls in and only ever replaces text that
        is already correct, so no JavaScript, a failed script, and reduced
        motion all leave the right figures on screen.
      </p>
      <p class="mt-3 max-w-narrow text-small text-ink">
        Scroll it into view to see the count. Turn on your system's reduce
        motion setting and reload: the numbers should simply be there.
      </p>

      <div class="mt-8">
        <StatsBand
          heading="Our work in numbers"
          headingId="sg-statsband-heading"
          items={stats}
          lang={lang}
        />
      </div>

      <h3 class="mt-12">With no heading, and the load entrance</h3>
      <p class="mt-4 max-w-narrow">
        As the About band uses it (spec 0010): no{' '}
        <code class="font-mono text-small">h2</code>, so the list is named by
        the section around it, and{' '}
        <code class="font-mono text-small">entranceFrom</code> gives each figure
        the CSS <code class="font-mono text-small">entrance</code>, 80ms apart.
        Reload at the top of this tile to see them rise in.
      </p>
      <div class="mt-8">
        <StatsBand items={stats} lang={lang} entranceFrom={0} />
      </div>
    </Section>

    <Section tone="tint" labelledBy="sg-emphasis">
      <h2 id="sg-emphasis">Marked text</h2>
      <p class="mt-4 max-w-narrow">
        <code class="font-mono text-small">Emphasis</code> renders one line of
        content copy with its two marks:{' '}
        <code class="font-mono text-small">**bold**</code> in the surrounding
        colour and <code class="font-mono text-small">==gold==</code> in the
        gold the surface allows. The real About intro, on a light tone and then
        on black, where the same mark turns{' '}
        <code class="font-mono text-small">--color-gold-on-dark</code>.
      </p>
      <p class="mt-8 max-w-narrow">
        <Emphasis text={about.intro} surface="light" />
      </p>
      <p class="mt-6 max-w-narrow rounded-ui bg-black p-6 text-white">
        <Emphasis text={about.intro} surface="dark" />
      </p>
    </Section>

    <Section labelledBy="sg-accordion">
      <h2 id="sg-accordion">Accordion</h2>
      <p class="mt-4 max-w-narrow">
        The browser's own <code class="font-mono text-small">details</code>, one
        open at a time through a shared{' '}
        <code class="font-mono text-small">name</code>, the first open on load.
        Closed items are gold bars, the open one a white card. Tab to a summary:
        the ring is the two colour one, because the group carries{' '}
        <code class="font-mono text-small">focus-contrast</code>. Enter or Space
        toggles. In Chrome and Edge the panel slides; elsewhere, and with reduce
        motion on, it opens at once.
      </p>
      <div class="mt-8 max-w-narrow">
        <Accordion name="sg-accordion" items={about.capability.accordion} />
      </div>
    </Section>

    <Section tone="tint" labelledBy="sg-ctaband">
      <h2 id="sg-ctaband">Closing call to action</h2>
      <p class="mt-4 max-w-narrow">
        The one gold band on the site, and deliberately not a third{' '}
        <code class="font-mono text-small">Section</code> tone: two tones and
        both light is what lets every other component name its colours directly
        and never read a tone variable.
      </p>
      <p class="mt-3 max-w-narrow text-small text-ink">
        Tab to its link. The ring is the <strong>two colour ring</strong>, black
        inside and white outside, the rule for every surface that is not a light
        tone, because <code class="font-mono text-small">--color-gold-ink</code>{' '}
        on full gold measures 2.10:1. The band carries{' '}
        <code class="font-mono text-small">focus-contrast</code>, so the link
        sets no ring of its own. Same 2px width, same 2px offset, still keyboard
        only.
      </p>

      {firstServiceCta && (
        <div class="mt-8 overflow-hidden rounded-ui border border-line">
          <CtaBand
            heading={firstServiceCta.heading}
            headingId="sg-ctaband-heading"
            text={firstServiceCta.text}
            button={firstServiceCta.button}
          />
        </div>
      )}
    </Section>

    <Section labelledBy="sg-gallery">
      <h2 id="sg-gallery">Project gallery</h2>
      <p class="mt-4 max-w-narrow">
        The Project page's photo wall, from the real project entries: fixed 5:4
        tiles, 8px seams (the grid gap's one written exception), and a full
        width scrim strip carrying the service and the title in white, 5.74:1 at
        worst over any photo.
      </p>
      <p class="mt-3 max-w-narrow text-small text-ink">
        Tab through it: there is no stop inside. Hover a tile with a mouse and
        only its photo slowly zooms; the cursor stays an arrow, and with reduced
        motion nothing grows. The tiles are not links until project detail pages
        exist. On the page the wall has no maximum width; here it sits inside
        this section's column.
      </p>

      {projects.length > 0 && (
        <div class="mt-8 overflow-hidden rounded-ui border border-line pt-4 md:pt-6 lg:pt-8">
          <ProjectGallery
            labelledBy="sg-gallery"
            projects={projects}
            cue={projectPage.tileCue}
          />
        </div>
      )}
    </Section>

    <Section labelledBy="sg-photo-focus">
      <h2 id="sg-photo-focus">Focus on a photo</h2>
      <p class="mt-4 max-w-narrow">
        The home hero's surface: the real hero photo, the{' '}
        <code class="font-mono text-small">--color-scrim</code> panel, and white
        text on it. White on the scrim is 5.74:1 even over a pure white pixel,
        so no photo swap needs a contrast check.
      </p>
      <p class="mt-3 max-w-narrow text-small text-ink">
        Tab to the button. It shows the same two colour ring as the gold band,
        from <code class="font-mono text-small">focus-contrast</code> on the
        swatch, and reads on the bright sky and the dark city alike.
      </p>

      <div class="focus-contrast relative isolate mt-8 flex flex-col items-center gap-6 overflow-hidden rounded-ui bg-black px-4 py-12">
        <Image
          src={home.hero.images[0].src}
          alt=""
          inferSize
          widths={[640, 1280]}
          sizes="(min-width: 75rem) 75rem, 100vw"
          class="absolute inset-0 -z-10 size-full object-cover object-center"
        />
        <p class="rounded-ui bg-scrim px-6 py-4 text-lead text-white">
          {home.hero.subheading}
        </p>
        <Button href={home.hero.primaryCta.href}>
          {home.hero.primaryCta.label}
        </Button>
      </div>
    </Section>

    <Section tone="tint" labelledBy="sg-form-band-intro">
      <h2 id="sg-form-band-intro">The contact form band</h2>
      <p class="mt-4 max-w-narrow">
        The one dark band that holds fields (spec 0011): a greyscale photo under{' '}
        <code class="font-mono text-small">--color-scrim-strong</code> and the{' '}
        <code class="font-mono text-small">bg-diagonal-dark</code> stripe. Its
        lightest pixel is #3f3f3f, where white reads at 10.5:1 and{' '}
        <code class="font-mono text-small">--color-error-on-dark</code> at
        5.19:1.
      </p>
      <p class="mt-3 max-w-narrow text-small text-ink">
        The fields pass <code class="font-mono text-small">surface="dark"</code>
        : white label and hint, light error, the same white box. The hint sits
        on the label's line, so a row lines up with or without one. The cards
        are white surfaces and follow the light rules. Tab through: the band
        carries <code class="font-mono text-small">focus-contrast</code>.
      </p>
    </Section>

    <FormBand
      heading={contact.form.heading}
      headingId="sg-form-band-heading"
      background={contact.form.background.src}
      noScript={contact.form.noScript}
      email={contact.details.email}
      phone={contact.details.phone}
    >
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <TextField
          id="sg-dark-name"
          name="dark-name"
          label={contact.form.labels.name}
          surface="dark"
          aria-required="true"
        />
        <TextField
          id="sg-dark-phone"
          name="dark-phone"
          type="tel"
          label={contact.form.labels.phone}
          hint={contact.form.optionalHint}
          surface="dark"
        />
        <TextField
          id="sg-dark-email-invalid"
          name="dark-email-invalid"
          type="email"
          label={contact.form.labels.email}
          error={contact.errors.email}
          defaultValue="not-an-email"
          surface="dark"
        />
        <Select
          id="sg-dark-lod"
          name="dark-lod"
          label={contact.form.labels.lod}
          hint={contact.form.optionalHint}
          options={contact.form.lodOptions}
          prompt={contact.form.selectPrompt}
          surface="dark"
        />
        <Select
          id="sg-dark-project-invalid"
          name="dark-project-invalid"
          label={contact.form.labels.projectType}
          hint={contact.form.optionalHint}
          options={contact.form.projectTypes}
          prompt={contact.form.selectPrompt}
          error={contact.errors.required}
          surface="dark"
        />
        <div class="md:col-span-2">
          <TextArea
            id="sg-dark-message"
            name="dark-message"
            label={contact.form.labels.message}
            error={contact.errors.tooLong}
            rows={3}
            surface="dark"
          />
        </div>
      </div>

      <ContactCard
        slot="cards"
        icon="headset"
        heading={contact.cards.talk.heading}
        body={{
          label: contact.details.phone,
          href: telHref(contact.details.phone),
        }}
      />
      <ContactCard
        slot="cards"
        icon="map-pin"
        heading={contact.cards.visit.heading}
        body={contact.details.address}
      />
      <ContactCard
        slot="cards"
        icon="envelope"
        heading={{
          label: contact.details.email,
          href: `mailto:${contact.details.email}`,
        }}
      />
    </FormBand>
  </main>
</BaseLayout>
