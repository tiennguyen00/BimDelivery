---
/**
 * A service page's features in the `split` layout (spec 0013): the ruled
 * heading and paragraphs on the start side, the items as tiles on the end
 * side.
 *
 * It renders only the inside of the band; the route wraps it in a
 * `PatternBand` on the block's `surface`, and its colours come from the band
 * strings in `styles.ts`, the same on either pattern.
 *
 * From `lg` the copy takes about five twelfths and the tiles the rest; the
 * tiles run two columns from `md` and one below. Below `lg` everything is
 * one column, the copy first. Each tile holds a 40px line icon with a 1.5
 * stroke, the title as an `h3`, and its text with its marks.
 *
 * Motion: the copy reveals as one, then the tiles one after another, and the
 * heading draws its rule with the scroll direction. `entranceFrom` also gives
 * each of those units the load entrance (`entrance.ts`).
 */
import Emphasis from '../ui/Emphasis.astro';
import Icon from '../ui/Icon.astro';
import {
  bandBodyClass,
  bandHeadingClass,
  bandIconClass,
  bandTileClass,
  cx,
} from '../ui/styles';
import { entranceClass, entranceStyle } from '../ui/entrance';
import type { BandProps } from '../../lib/service-page';

type Props = BandProps<'features/split'>;

const { block, headingId, entranceFrom } = Astro.props;
---

<div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
  <div
    class={cx('lg:col-span-5', entranceClass(entranceFrom))}
    style={entranceStyle(entranceFrom, 0)}
    data-reveal
  >
    <h2
      id={headingId}
      class={cx('heading-rule inline-block', bandHeadingClass)}
      data-heading-rule
    >
      <Emphasis text={block.heading} />
    </h2>

    <div class={cx('mt-8 flex flex-col gap-4', bandBodyClass)}>
      {block.paragraphs.map((paragraph) => (
        <p>
          <Emphasis text={paragraph} />
        </p>
      ))}
    </div>
  </div>

  <div
    class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:col-span-7"
    data-reveal-stagger
  >
    {block.items.map((item, index) => (
      <div
        class={cx(
          'flex flex-col p-6',
          bandTileClass,
          entranceClass(entranceFrom),
        )}
        style={entranceStyle(entranceFrom, index + 1)}
      >
        <Icon
          name={item.icon}
          size={40}
          strokeWidth={1.5}
          class={bandIconClass}
        />
        <h3 class={cx('mt-4', bandHeadingClass)}>{item.title}</h3>
        <p class={cx('mt-2', bandBodyClass)}>
          <Emphasis text={item.text} />
        </p>
      </div>
    ))}
  </div>
</div>
