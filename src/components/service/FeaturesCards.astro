---
/**
 * A service page's features in the `cards` layout (spec 0013): a centred
 * ruled heading, the paragraphs, a centred ruled subheading, then one card
 * per stage.
 *
 * It renders only the inside of the band; the route wraps it in a
 * `PatternBand` on the block's `surface`. Its colours come from the band
 * strings in `styles.ts`, the same on either pattern: `heading` headings,
 * `ink` text, and a `==` phrase in `Emphasis`'s accent.
 *
 * The cards are one column below `lg` and one row of equal columns from it,
 * however many there are (`lg:grid-flow-col lg:auto-cols-fr`): literal
 * classes that fit any count, never a class built from the count. Each card
 * is plain, with no panel box, left aligned, top to bottom: its two digit
 * number (`01`) at the `text-h1` size and a regular weight, a `line` rule,
 * the title as an `h4` in the `text-h3` style, then the points as short lines
 * in the small size. The cards are an `ol`, so the order is in the markup and
 * the visible number is hidden from screen readers.
 *
 * Motion: the heading block (the heading, the paragraphs, and the
 * subheading) reveals as one, then the cards one after another, and both
 * ruled headings draw their rule with the scroll direction. `entranceFrom`
 * also gives each of those units the load entrance (`entrance.ts`).
 */
import Emphasis from '../ui/Emphasis.astro';
import { bandBodyClass, bandHeadingClass, cx } from '../ui/styles';
import { entranceClass, entranceStyle } from '../ui/entrance';
import type { BandProps } from '../../lib/service-page';

type Props = BandProps<'features/cards'>;

const { block, headingId, entranceFrom } = Astro.props;
---

<div
  class={entranceClass(entranceFrom)}
  style={entranceStyle(entranceFrom, 0)}
  data-reveal
>
  <div class="text-center">
    <h2
      id={headingId}
      class={cx('heading-rule inline-block', bandHeadingClass)}
      data-heading-rule
    >
      <Emphasis text={block.heading} />
    </h2>
  </div>

  <div class={cx('mt-8 flex flex-col gap-4', bandBodyClass)}>
    {block.paragraphs.map((paragraph) => (
      <p>
        <Emphasis text={paragraph} />
      </p>
    ))}
  </div>

  <div class="mt-16 text-center">
    <h3
      class={cx('heading-rule inline-block', bandHeadingClass)}
      data-heading-rule
    >
      <Emphasis text={block.subheading} />
    </h3>
  </div>
</div>

<ol
  class="mt-12 grid grid-cols-1 gap-10 lg:auto-cols-fr lg:grid-flow-col lg:gap-8"
  data-reveal-stagger
>
  {block.cards.map((card, index) => (
    <li
      class={cx('flex flex-col', entranceClass(entranceFrom))}
      style={entranceStyle(entranceFrom, index + 1)}
    >
      <span
        class={cx(
          'font-display text-h1 font-normal tabular-nums lining-nums',
          bandHeadingClass,
        )}
        aria-hidden="true"
      >
        {String(index + 1).padStart(2, '0')}
      </span>
      <h4
        class={cx(
          'mt-4 border-t border-line pt-4 text-h3 font-bold',
          bandHeadingClass,
        )}
      >
        {card.title}
      </h4>
      <ul class={cx('mt-3 flex flex-col gap-1.5 text-small', bandBodyClass)}>
        {card.points.map((point) => (
          <li>{point}</li>
        ))}
      </ul>
    </li>
  ))}
</ol>
