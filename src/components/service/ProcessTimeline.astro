---
/**
 * A service page's process in the `timeline` layout (spec 0013): a centred
 * ruled heading and an optional intro, the numbered steps joined by a line,
 * then the closing call to action back to the contact page.
 *
 * It renders only the inside of the band; the route wraps it in a
 * `PatternBand` on the block's `surface`, and its words take the band strings
 * in `styles.ts`. The number circles and the button are `accent` fills
 * carrying `on-accent`; the connector is the decorative `line` (Coffee),
 * the same on either pattern.
 *
 * The steps are an `<ol>`. From `lg` they sit in one row of equal columns,
 * however many there are (`lg:grid-flow-col lg:auto-cols-fr`); below it they
 * are a list running down the page. Each step draws the stretch of line from
 * its own circle's centre to the next one's with an `::after`, so the line
 * joins exactly the circles there are and the last step draws none. That is
 * why the spacing between steps is padding rather than a gap: the stretch is
 * the step's own width (a row) or height (a list), which then reaches the
 * next centre exactly. The circles sit above it.
 *
 * Each number is the step's position plus one, written as text, so a screen
 * reader reads it with the step.
 *
 * Motion: the heading block reveals, then the steps one after another, then
 * the closing, and the heading draws its rule with the scroll direction. A
 * step fading in brings its stretch of line with it, so the line grows step
 * by step. `entranceFrom` also gives each of those units the load entrance
 * (`entrance.ts`).
 */
import Button from '../ui/Button.astro';
import Emphasis from '../ui/Emphasis.astro';
import { bandBodyClass, bandHeadingClass, cx } from '../ui/styles';
import { entranceClass, entranceStyle } from '../ui/entrance';
import type { BandProps } from '../../lib/service-page';

type Props = BandProps<'process/timeline'>;

const { block, headingId, entranceFrom } = Astro.props;
const { cta } = block;
---

<div
  class={cx('mx-auto max-w-narrow text-center', entranceClass(entranceFrom))}
  style={entranceStyle(entranceFrom, 0)}
  data-reveal
>
  <h2
    id={headingId}
    class={cx('heading-rule inline-block', bandHeadingClass)}
    data-heading-rule
  >
    <Emphasis text={block.heading} />
  </h2>
  {block.intro && (
    <p class={cx('mt-8', bandBodyClass)}>
      <Emphasis text={block.intro} />
    </p>
  )}
</div>

<ol
  class="mt-12 grid grid-cols-1 lg:auto-cols-fr lg:grid-flow-col"
  data-reveal-stagger
>
  {block.steps.map((step, index) => (
    <li
      class={cx(
        'relative flex gap-6 pb-10 after:absolute after:inset-s-7 after:top-7 after:h-full after:w-1 after:-translate-x-1/2 after:bg-line last:pb-0 last:after:hidden lg:flex-col lg:items-center lg:gap-6 lg:px-4 lg:pb-0 lg:text-center lg:after:inset-s-1/2 lg:after:h-1 lg:after:w-full lg:after:translate-x-0 lg:after:-translate-y-1/2',
        entranceClass(entranceFrom),
      )}
      style={entranceStyle(entranceFrom, index + 1)}
    >
      <span class="relative z-10 grid size-14 shrink-0 place-items-center rounded-full bg-accent text-h3 font-bold text-on-accent">
        {index + 1}
      </span>
      <div>
        <h3 class={bandHeadingClass}>{step.title}</h3>
        <p class={cx('mt-2', bandBodyClass)}>{step.text}</p>
      </div>
    </li>
  ))}
</ol>

<div
  class={cx(
    'mx-auto mt-16 max-w-narrow text-center',
    entranceClass(entranceFrom),
  )}
  style={entranceStyle(entranceFrom, block.steps.length + 1)}
  data-reveal
>
  <h3 class={bandHeadingClass}>{cta.heading}</h3>
  <p class={cx('mt-4', bandBodyClass)}>{cta.text}</p>
  <Button href={cta.button.href} class="mt-8">
    {cta.button.label}
  </Button>
</div>
