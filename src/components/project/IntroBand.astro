---
/**
 * The Project page's first band (spec 0014): the page's `h1` with the gold
 * rule under it, and one paragraph in the narrow reading width.
 *
 * It renders only the inside of the band; the page wraps it in a `white`
 * `Section` labelled by the `h1`, as the About and Contact pages do with
 * their intro bands. The capitals are CSS only (`uppercase`), so a screen
 * reader reads words, not letters.
 *
 * On page load the heading and the paragraph fade and rise in through the
 * `entrance` utility (steps 0, 1), pure CSS. The band never takes
 * `data-reveal`, so the scroll reveal never touches what the entrance
 * animates. The heading carries `data-heading-rule`, so its rule runs back
 * and draws again with the scroll direction like every ruled heading, once
 * the page imports `reveal.ts`.
 */
import Emphasis from '../ui/Emphasis.astro';

interface Props {
  heading: string;
  /** The id the surrounding Section points at with `aria-labelledby`. */
  headingId: string;
  /** May carry `**bold**` and `==gold==` phrases. */
  intro: string;
}

const { heading, headingId, intro } = Astro.props;
---

<h1
  id={headingId}
  class="entrance heading-rule inline-block uppercase"
  style="--entrance-step: 0"
  data-heading-rule
>
  {heading}
</h1>

<p class="entrance mt-8 max-w-narrow text-lead" style="--entrance-step: 1">
  <Emphasis text={intro} surface="light" />
</p>
