---
/**
 * A project detail page's way on (spec 0015): one centred link to the next
 * project, so a visitor never reaches a dead end.
 *
 * It renders only the inside of the band; the page wraps it in a `white`,
 * `narrow` `Section` with no label, and leaves the band out when the
 * language has only one project. Which project is next is decided by
 * `nextProject`, never here.
 *
 * The label and the title sit inside one link, so its accessible name is
 * both ("Next project Harbour Tower"); the space between the two spans keeps
 * the words apart in that name. The title underlines on hover, and keyboard
 * focus draws the light tone `gold-ink` ring from the base styles. The arrow
 * is decorative.
 */
import Icon from '../ui/Icon.astro';

interface Props {
  label: string;
  title: string;
  href: string;
}

const { label, title, href } = Astro.props;
---

<div class="text-center">
  <a
    href={href}
    class="group inline-flex flex-col items-center gap-2 rounded-ui p-2"
  >
    <span class="text-small font-semibold tracking-wide text-ink-muted uppercase">
      {label}
    </span>{' '}
    <span class="inline-flex items-center gap-3 text-h3 font-semibold text-ink-strong">
      <span class="text-balance group-hover:underline">{title}</span>
      <Icon name="arrow-right" class="shrink-0 text-gold-ink" />
    </span>
  </a>
</div>
