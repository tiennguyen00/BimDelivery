---
/**
 * The Project page's photo wall (spec 0014): every project as a 5:4 photo
 * tile, three across on a desktop, with thin 8px white seams between them.
 *
 * It is a band of its own, not a `Section`: it borrows the band frame's side
 * gutters and bottom padding from `styles.ts` but takes **no maximum width**,
 * so the wall runs the full window width inside the gutters. It has no top
 * padding because it sits straight under the intro, on the same white. It
 * needs no name of its own either: the list is labelled by the page's `h1`.
 * The page never renders it with an empty list; it shows the empty state
 * instead.
 *
 * Each tile's box is a fixed 5:4 (`aspect-5/4`), so its space is reserved
 * before the photo arrives and nothing on the page shifts as photos load.
 * The black fill shows only while a photo loads. The caption is a full width
 * `bg-scrim` strip at the tile's foot: white on the scrim is 5.74:1 even over
 * a pure white pixel (spec 0005), so any photo is safe without a contrast
 * check. The 60 character title cap in the content schema is what keeps the
 * caption inside the tile at every width.
 *
 * The tiles are not links: there are no project detail pages yet. A tile
 * holds nothing focusable and never promises a click (the cursor stays the
 * default). Its one hover response is a slow zoom of the photo alone, 105%
 * over 500ms, `motion-safe` so reduced motion gets no zoom at all; the box,
 * the caption, and the layout never move. The zoom takes only the `Image`,
 * by `scale`, while the entrance and the reveal take only the `<li>`, so
 * neither overwrites the other. `isolate` stays with `overflow-hidden` on the
 * `<li>`: the stacking context keeps the growing photo clipped to the rounded
 * corners (without it WebKit can draw square corners mid transition).
 *
 * Motion: the list is a `data-reveal-stagger` container, so below the fold
 * each tile fades and rises in after the one before as it scrolls into view.
 * The first row also takes the load entrance, counting up from
 * `entranceFrom`, the spec 0012/0013 rule for a band on screen at load on a
 * desktop and below the fold on a phone. Only the first row, never every
 * tile, so a long list never stacks up seconds of delay.
 */
import { Image } from 'astro:assets';
import type { Project } from '../../lib/content';
import { entranceClass, entranceStyle } from '../ui/entrance';
import { bandGutterClass, bandPaddingBottomClass, cx } from '../ui/styles';
import {
  wallGridClass,
  wallImageClass,
  wallImageSizes,
  wallImageWidths,
  wallTileClass,
} from './wall';

interface Props {
  /** The id of the page's `h1`, which names the list. */
  labelledBy: string;
  /** One or more, in `order`. */
  projects: readonly Project[];
  /** The first tile's `--entrance-step`; without it no tile moves on load. */
  entranceFrom?: number;
}

const { labelledBy, projects, entranceFrom } = Astro.props;

/**
 * The tiles a desktop shows at load, its first row. They are the page's
 * largest paint there, so their photos load eagerly and they take the load
 * entrance; every later one is lazy and moves only by the scroll reveal.
 */
const FIRST_ROW = 3;

const entranceAt = (index: number): number | undefined =>
  index < FIRST_ROW ? entranceFrom : undefined;
---

<div class={cx('bg-white', bandGutterClass, bandPaddingBottomClass)}>
  <ul aria-labelledby={labelledBy} class={wallGridClass} data-reveal-stagger>
    {projects.map((project, index) => (
      <li
        class={cx(
          wallTileClass,
          'group flex flex-col justify-end',
          entranceClass(entranceAt(index)),
        )}
        style={entranceStyle(entranceAt(index), index)}
      >
        <Image
          src={project.image.src}
          alt={project.image.alt ?? ''}
          inferSize
          widths={[...wallImageWidths]}
          sizes={wallImageSizes}
          loading={index < FIRST_ROW ? 'eager' : 'lazy'}
          class={cx(
            wallImageClass,
            'transition-[scale] duration-500 ease-out motion-safe:group-hover:scale-105',
          )}
        />
        <div class="bg-scrim px-5 py-4 text-white md:px-6 md:py-5">
          <p class="text-small font-semibold tracking-wide uppercase">
            {project.service.title}
          </p>
          <h2 class="mt-1 text-h3 font-semibold text-balance text-white">
            {project.title}
          </h2>
        </div>
      </li>
    ))}
  </ul>
</div>
