---
/**
 * One of the Contact page's three cards (spec 0011): a large accent icon
 * above a heading, then an optional value, centred on a `panel` card.
 *
 * The heading and the value are each plain text or a link, because the email
 * card's heading is the address itself, and the phone is a `tel:` link a
 * phone can dial.
 *
 * The heading is bold `accent` at `text-h3` (5.04:1 on `panel`), the value
 * `ink-strong` (10.35:1), and the icon an `accent` fill, which is decoration
 * and hidden from assistive tech. A link keeps the
 * shared focus ring, the two colour one the band passes down through
 * `focus-contrast`.
 */
import Icon, { type IconName } from '../ui/Icon.astro';
import type { Link } from '../../lib/content';

type CardText = string | Link;

interface Props {
  icon: IconName;
  heading: CardText;
  body?: CardText;
}

const { icon, heading, body } = Astro.props;

const linkClass = 'underline-offset-4 hover:underline';
---

<div class="flex flex-col items-center rounded-ui bg-panel px-6 py-8 text-center">
  <Icon name={icon} size={56} class="fill-accent" />

  <h3 class="mt-4 font-bold text-accent wrap-anywhere">
    {typeof heading === 'string' ? (
      heading
    ) : (
      <a href={heading.href} class={linkClass}>
        {heading.label}
      </a>
    )}
  </h3>

  {body !== undefined && (
    <p class="mt-2 text-ink-strong wrap-anywhere">
      {typeof body === 'string' ? (
        body
      ) : (
        <a href={body.href} class={linkClass}>
          {body.label}
        </a>
      )}
    </p>
  )}
</div>
