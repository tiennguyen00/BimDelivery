---
/**
 * The Contact page's second band (spec 0011): a greyscale construction photo
 * under a dark see through layer and a faint stripe, holding the form on the
 * start side and the three contact cards on the end side.
 *
 * It is its own band, not a `Section` tone, because it is a photo surface,
 * like the home hero. It borrows `Section`'s frame from `styles.ts`, so its
 * gutters and widths cannot drift from the rest of the page, and it carries
 * `focus-contrast`, the ring for photos and accent fills.
 *
 * What holds the contrast together: nothing reads straight off the photo.
 * The layer over it is `scrim-strong` (Chinese Black at 90 percent) plus the
 * `bg-diagonal` stripe, so the band's lightest possible pixel is `#31393c`,
 * and there `heading` reaches 10.11:1, `ink` 7.44:1, `ink-muted` 5.32:1,
 * `error` 5.15:1, and `accent` 4.92:1, whatever the photo. The band itself
 * is `canvas`, so a photo that fails to load leaves the same words on a
 * darker band. The fields and cards follow the same dark rules as anywhere.
 *
 * The photo and its layer fade into `canvas` at the band's top and bottom
 * (`bandFadeClass`, 2026-10-13), so the band eases out of the intro above and
 * into the footer below. The fade only darkens, so every ratio above holds.
 *
 * From `lg` the form takes about seven twelfths and the cards the rest. Below
 * `lg` it is one column: heading, form, cards.
 *
 * The page fills two slots: the default one with the form island, and
 * `cards` with the cards. The `<noscript>` note sits above the form, so a
 * visitor with JavaScript off meets it before the fields they cannot use.
 *
 * Reveal order: the heading, then the form, then each card in turn. All
 * inert unless the page imports `reveal.ts`.
 *
 * The band starts on screen at load on every screen, its top about two
 * thirds of the way down, where the scroll reveal leaves it alone. So
 * `entranceFrom` (2026-10-31) also gives the heading and the form the load
 * `entrance`, at that step and the next, the spec 0012/0013 rule; the page
 * gives each card the steps after them. On screen the entrance moves a unit,
 * below the fold the scroll reveal.
 */
import { Image } from 'astro:assets';
import { entranceClass, entranceStyle } from '../ui/entrance';
import {
  bandFadeClass,
  bandGutterClass,
  bandPaddingClass,
  bandWidthClass,
  cx,
} from '../ui/styles';
import { telHref } from '../../lib/contact';

interface Props {
  heading: string;
  /** The id this band points at with `aria-labelledby`. */
  headingId: string;
  /** A decorative photo link; it carries no `alt`. */
  background: string;
  /** The note shown instead of a working form when JavaScript is off. */
  noScript: string;
  email: string;
  phone: string;
  /**
   * The heading's `--entrance-step`, the form's is the next. Without it the
   * band does not move on load.
   */
  entranceFrom?: number;
}

const { heading, headingId, background, noScript, email, phone, entranceFrom } =
  Astro.props;
---

<section
  aria-labelledby={headingId}
  class={cx(
    'focus-contrast relative isolate bg-canvas',
    bandGutterClass,
    bandPaddingClass,
  )}
>
  <Image
    src={background}
    alt=""
    inferSize
    widths={[640, 960, 1280, 1920, 2560]}
    sizes="100vw"
    loading="lazy"
    class="absolute inset-0 -z-20 size-full object-cover object-center grayscale"
  />
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-scrim-strong bg-diagonal"
  ></div>
  <div aria-hidden="true" class={cx('absolute -z-10', bandFadeClass.top)}></div>
  <div
    aria-hidden="true"
    class={cx('absolute -z-10', bandFadeClass.bottom)}
  ></div>

  <div class={bandWidthClass.default}>
    <h2
      id={headingId}
      class={cx(
        'text-balance text-heading uppercase',
        entranceClass(entranceFrom),
      )}
      style={entranceStyle(entranceFrom, 0)}
      data-reveal
    >
      {heading}
    </h2>

    <div class="mt-10 grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-start lg:gap-16">
      <div class="lg:col-span-7">
        <noscript>
          <div class="mb-8 text-heading">
            <p>{noScript}</p>
            <p class="mt-2 flex flex-wrap gap-x-6 gap-y-2">
              <a
                href={`mailto:${email}`}
                class="font-semibold underline wrap-anywhere"
              >
                {email}
              </a>
              <a href={telHref(phone)} class="font-semibold underline">
                {phone}
              </a>
            </p>
          </div>
        </noscript>

        <div
          class={entranceClass(entranceFrom)}
          style={entranceStyle(entranceFrom, 1)}
          data-reveal
        >
          <slot />
        </div>
      </div>

      <div
        class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:col-span-5 lg:grid-cols-1"
        data-reveal-stagger
      >
        <slot name="cards" />
      </div>
    </div>
  </div>
</section>
