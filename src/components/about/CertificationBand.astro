---
/**
 * The About page's last band (spec 0010): a centred, ruled heading in
 * capitals, the paragraphs, and the certification badges in one centred row
 * that wraps.
 *
 * It renders only the inside of the band; the page wraps it in a `canvas`
 * `Section` with `bg-diagonal`, as the home presence band is. Text on the
 * stripe stays `ink` or stronger (4.56:1 at worst, over a stripe line).
 *
 * The badges are the footer's own list (`settings.footer.certification`), so
 * they are written once for the site; the page turns the footer's panel off
 * so they appear once per page. They are square, lazy, and 7rem tall on a
 * phone, 8rem from `md`, and 9rem from `lg`, which is what lets five sit in
 * one row in the band's 800px at 1024.
 *
 * Reveal order: the heading block, then the paragraphs (one stagger group),
 * then each badge in turn (a second one). The heading's rule draws with the
 * scroll direction. All inert unless the page imports `reveal.ts`.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Emphasis from '../ui/Emphasis.astro';

interface Props {
  heading: string;
  /** The id the surrounding Section points at with `aria-labelledby`. */
  headingId: string;
  /** Each may carry `**bold**` and `==accent==` phrases. */
  paragraphs: readonly string[];
  badges: readonly Readonly<{ src: ImageMetadata; alt: string }>[];
}

const { heading, headingId, paragraphs, badges } = Astro.props;
---

<div data-reveal-stagger>
  <div class="text-center">
    <h2
      id={headingId}
      class="heading-rule inline-block uppercase"
      data-heading-rule
    >
      {heading}
    </h2>
  </div>

  <div class="mt-8 flex flex-col gap-4">
    {paragraphs.map((paragraph) => (
      <p>
        <Emphasis text={paragraph} />
      </p>
    ))}
  </div>
</div>

<ul
  class="mt-12 flex list-none flex-wrap justify-center gap-4 p-0"
  data-reveal-stagger
>
  {badges.map((badge) => (
    <li>
      <Image
        src={badge.src}
        alt={badge.alt}
        loading="lazy"
        class="h-28 w-auto md:h-32 lg:h-36"
      />
    </li>
  ))}
</ul>
