---
/**
 * One band of the About & Services page (2026-10-11): copy on one side, a
 * full height photo on the other, after the engineer's reference. The copy
 * is a heading (capitals, CSS only, so a screen reader reads words), a brass
 * tagline, the paragraphs, and an optional button; the photo runs to the
 * screen's edge and the band's top and bottom.
 *
 * The photo never meets `canvas` in a hard line (2026-10-13): its top and
 * bottom fade into `canvas` over the band padding (`bandFadeClass`), and from
 * `lg` the side that faces the copy fades too, a quarter of its width, so the
 * copy and the photo read as one surface and two stacked bands melt together.
 *
 * It is its own band, not a `Section` tone, because its photo bleeds past the
 * band frame. The copy column borrows the frame's gutters and padding from
 * `styles.ts`, on `canvas`, so every pair in it is a `canvas` one and the band
 * takes no `focus-contrast`: no word ever sits on the photo.
 *
 * From `lg` the copy takes five of twelve columns and the photo seven, the
 * band at least a screen tall (`split-band-height`). The page flips
 * `imageSide` from one band to the next, so the second does not read as the
 * first printed again. On a phone and a tablet the copy comes first and the
 * photo follows it full width at 3:2, whichever side it takes at `lg`.
 *
 * Motion, chosen by the page:
 *
 * - `entrance`, for the band on screen at load: the heading, the tagline,
 *   each paragraph, then the button fade and rise in through the CSS
 *   `entrance` utility, 80ms apart. The photo stays still: it is the page's
 *   largest paint, so it loads eagerly at a high fetch priority.
 * - `reveal`, for every band below it: the copy's parts reveal one after
 *   another as they scroll into view (`data-reveal-stagger`), and the photo
 *   with them. Inert until the page imports `src/scripts/reveal.ts`.
 */
import Photo from '../ui/Photo.astro';
import Button from '../ui/Button.astro';
import Emphasis from '../ui/Emphasis.astro';
import Icon from '../ui/Icon.astro';
import {
  bandFadeClass,
  bandGutterClass,
  bandPaddingClass,
  cx,
} from '../ui/styles';
import type { PhotoSource } from '../../lib/sanity-image';

interface Props {
  /** The band's id, the target of the button in the band above. */
  id?: string;
  /** `1` for the page's first band, whose heading is the page's `h1`. */
  headingLevel: 1 | 2;
  heading: string;
  /** The id the band points at with `aria-labelledby`. */
  headingId: string;
  tagline: string;
  /** Each may carry `**bold**` and `==accent==` phrases. */
  paragraphs: readonly string[];
  /** A Pexels link (About), or a project's Sanity photo (spec 0019). */
  image: PhotoSource;
  imageSide: 'start' | 'end';
  /** Absent: no button. `arrow-down` for a jump down the page. */
  action?: Readonly<{
    label: string;
    href: string;
    icon: 'arrow-down' | 'arrow-right';
  }>;
  motion: 'entrance' | 'reveal';
}

const {
  id,
  headingLevel,
  heading,
  headingId,
  tagline,
  paragraphs,
  image,
  imageSide,
  action,
  motion,
} = Astro.props;

const Heading = headingLevel === 1 ? 'h1' : 'h2';
const onLoad = motion === 'entrance';

/** The copy's parts in order, so each knows its entrance step. */
const step = (index: number): Readonly<{ class?: string; style?: string }> =>
  onLoad ? { class: 'entrance', style: `--entrance-step: ${index}` } : {};
const actionStep = 2 + paragraphs.length;
---

<section
  id={id}
  aria-labelledby={headingId}
  class="bg-canvas lg:grid lg:split-band-height lg:grid-cols-12"
>
  <div
    class={cx(
      'flex flex-col justify-center lg:col-span-5',
      bandGutterClass,
      bandPaddingClass,
      imageSide === 'start' && 'lg:order-2',
    )}
  >
    <div
      class="mx-auto flex w-full max-w-narrow flex-col lg:max-w-md"
      data-reveal-stagger={onLoad ? undefined : ''}
    >
      <Heading
        id={headingId}
        class:list={['text-balance uppercase', step(0).class]}
        style={step(0).style}
      >
        {heading}
      </Heading>
      <p
        class:list={[
          'mt-6 text-eyebrow font-semibold text-accent uppercase',
          step(1).class,
        ]}
        style={step(1).style}
      >
        {tagline}
      </p>
      {paragraphs.map((paragraph, index) => (
        <p
          class:list={['mt-6 text-body text-ink', step(2 + index).class]}
          style={step(2 + index).style}
        >
          <Emphasis text={paragraph} />
        </p>
      ))}
      {action && (
        <div
          class:list={['mt-10', step(actionStep).class]}
          style={step(actionStep).style}
        >
          <Button href={action.href}>
            {action.label}
            <Icon name={action.icon} size={20} />
          </Button>
        </div>
      )}
    </div>
  </div>

  <div
    class={cx(
      'relative aspect-3/2 overflow-hidden bg-panel lg:col-span-7 lg:aspect-auto',
      imageSide === 'start' && 'lg:order-1',
    )}
    data-reveal={onLoad ? undefined : ''}
  >
    <Photo
      photo={image}
      widths={[640, 960, 1280, 1600, 2000]}
      sizes="(min-width: 1024px) 58vw, 100vw"
      loading={onLoad ? 'eager' : 'lazy'}
      fetchpriority={onLoad ? 'high' : 'auto'}
      class="absolute inset-0 size-full object-cover"
    />
    <div aria-hidden="true" class={cx('absolute', bandFadeClass.top)}></div>
    <div aria-hidden="true" class={cx('absolute', bandFadeClass.bottom)}></div>
    <div
      aria-hidden="true"
      class={cx(
        'pointer-events-none absolute inset-y-0 hidden w-1/4 from-canvas to-transparent lg:block',
        imageSide === 'start'
          ? 'inset-e-0 bg-linear-to-l'
          : 'inset-s-0 bg-linear-to-r',
      )}
    ></div>
  </div>
</section>
