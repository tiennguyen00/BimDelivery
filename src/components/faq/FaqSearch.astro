---
/**
 * The FAQ's instant search (spec 0020), around the list it filters: the
 * search box, a status line, the list itself (the default slot), and the no
 * results message. The hub puts its prerendered results list in the slot,
 * a region page its questions. `src/scripts/faq.ts` brings it alive.
 *
 * It enhances markup that is already complete. The box and the status line
 * ship `no-js:hidden`, so with JavaScript off neither is there and the list
 * shows as it was built; the no results message ships `hidden` and only the
 * script ever shows it.
 *
 * Hooks, written here and in the list, never in content:
 *
 * - `form[data-faq-search]`, holding `data-faq-target` (the id of the list
 *   it filters), `data-faq-one` and `data-faq-other` (the status line's
 *   templates, each with `{count}`), and `data-faq-locale`.
 * - `[data-faq-status]`, the status line, `role="status"`, so a screen
 *   reader hears the count once the visitor pauses typing.
 * - `[data-faq-empty]`, the no results message.
 * - In the list: `[data-faq-text]` on every item the search can hide.
 *
 * The box: a `canvas` fill, the `field` border (5.04:1 against the fill),
 * `ink` words (11.66:1), an `ink-muted` placeholder (8.33:1), a decorative
 * magnifier, and the base `accent` focus ring. Its label is visually hidden;
 * the placeholder is a hint, never the label. Enter never reloads the page.
 */
import Icon from '../ui/Icon.astro';
import type { FaqPage } from '../../lib/content';

interface Props {
  copy: FaqPage['search'];
  /** The id of the list this search filters. */
  target: string;
  /** The search box's id, unique on the page and starting with `faq-`. */
  inputId: string;
  /** The page's language, for the count's plural rules and digits. */
  lang: string;
  class?: string;
}

const { copy, target, inputId, lang, class: className } = Astro.props;
---

<div class={className}>
  <form
    role="search"
    class="no-js:hidden"
    data-faq-search
    data-faq-target={target}
    data-faq-one={copy.results.one}
    data-faq-other={copy.results.other}
    data-faq-locale={lang}
  >
    <label for={inputId} class="sr-only">
      {copy.label}
    </label>
    <div class="relative">
      <Icon
        name="search"
        size={22}
        class="pointer-events-none absolute start-4 top-1/2 -translate-y-1/2 text-ink-muted"
      />
      <input
        id={inputId}
        type="search"
        name="q"
        autocomplete="off"
        spellcheck="false"
        enterkeyhint="search"
        placeholder={copy.placeholder}
        class="min-h-14 w-full rounded-ui border border-field bg-canvas py-3 ps-13 pe-4 text-lead text-ink placeholder:text-ink-muted"
      />
    </div>
  </form>

  <p
    role="status"
    class="mt-3 text-small text-ink-muted no-js:hidden"
    data-faq-status
  ></p>

  <slot />

  <div hidden class="py-10 text-center" data-faq-empty>
    <h2 class="text-h3">{copy.noResults.heading}</h2>
    <p class="mx-auto mt-3 max-w-narrow">{copy.noResults.text}</p>
  </div>
</div>
