---
/**
 * A FAQ region's two letter badge, "US" (spec 0020): the region's `code` in
 * bold capitals inside a square-ish box, on the hub cards, the region page's
 * header, and the region nav.
 *
 * It always sits next to the region's name, so it is hidden from assistive
 * tech and the name is read once (AC-18).
 *
 * - `outline`: an `accent` border and `accent` letters (7.71:1 on canvas,
 *   6.84:1 on raised, 5.04:1 on panel).
 * - `filled`: an `accent` fill with `on-accent` letters (7.71:1), for the
 *   region you are on in the region nav.
 *
 * The letters are the body face, not Playfair, which thins out at this
 * size, and their size comes from the type scale, so the box grows with it.
 */
import { cx } from '../ui/styles';

interface Props {
  code: string;
  size?: 'sm' | 'lg';
  tone?: 'outline' | 'filled';
  class?: string;
}

const { code, size = 'sm', tone = 'outline', class: className } = Astro.props;

const sizes = {
  sm: cx('h-7 min-w-9 px-1.5 text-small'),
  lg: cx('h-11 min-w-14 px-3 text-lead'),
} as const;

const tones = {
  outline: cx('border-accent text-accent'),
  filled: cx('border-accent bg-accent text-on-accent'),
} as const;
---

<span
  aria-hidden="true"
  class={cx(
    'inline-flex shrink-0 items-center justify-center rounded-ui border-2 leading-none font-bold tracking-wider',
    sizes[size],
    tones[tone],
    className,
  )}
>
  {code}
</span>
