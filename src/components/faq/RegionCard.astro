---
/**
 * One FAQ region on the hub (spec 0020): its badge, its name, its focus
 * line, and how many questions it holds, the whole card one link to the
 * region's page.
 *
 * It follows `Card`'s link rule: one link with one tab stop, on the name,
 * stretched over the card by its `after` layer, so the link's accessible
 * name is the region's name alone and a click anywhere on the card opens it.
 * Keyboard focus draws one `accent` ring round the whole card; hover
 * underlines the name, turns the border from `line` to `ink-muted`, and
 * nudges the arrow, never anything that reads as the focus ring.
 *
 * A `panel` surface with a `line` border. The name is `ink-strong` (10.35:1
 * on panel), the focus line `ink-muted` (5.45:1), the count `accent`
 * (5.04:1). The badge and the arrow are decoration, hidden from assistive
 * tech. Nothing truncates: a long name or focus line wraps.
 */
import Icon from '../ui/Icon.astro';
import RegionBadge from './RegionBadge.astro';

interface Props {
  code: string;
  name: string;
  focus: string;
  /** "10 questions", already worded. */
  count: string;
  href: string;
}

const { code, name, focus, count, href } = Astro.props;
---

<article class="group relative flex h-full flex-col rounded-ui border border-line bg-panel p-6 transition-colors duration-150 hover:border-ink-muted link-focus:outline-2 link-focus:outline-offset-2 link-focus:outline-accent">
  <div class="flex items-center justify-between gap-4">
    <RegionBadge code={code} size="lg" />
    <Icon
      name="arrow-right"
      size={24}
      class="text-accent transition-transform duration-150 group-hover:translate-x-1"
    />
  </div>
  <h3 class="mt-6 text-h3 text-balance text-ink-strong">
    <a
      href={href}
      class="underline-offset-4 after:absolute after:inset-0 focus-visible:outline-none group-hover:underline"
    >
      {name}
    </a>
  </h3>
  <p class="mt-3 text-ink-muted">{focus}</p>
  <p class="mt-auto pt-6 text-small font-semibold text-accent">{count}</p>
</article>
