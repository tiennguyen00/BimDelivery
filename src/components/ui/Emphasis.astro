---
/**
 * One line of marked copy (spec 0010): the only place a `**bold**` or
 * `==accent==` phrase from content becomes markup. It renders inline runs and
 * no wrapper, so the caller owns the `<p>` and its colour.
 *
 * - `**phrase**` is bold in the surrounding colour. A caller whose bold
 *   phrases take a stronger ink passes it through `strongClass` (the home
 *   presence band's `ink-strong`).
 * - `==phrase==` is bold `accent`, legible on every dark surface (5.04:1 at
 *   worst, on `panel`), or bold `heading` when the caller passes `onPhoto`:
 *   brass over the scrim is 2.88:1, and text on a photo is only ever
 *   `heading` (spec 0003's accent role rule).
 *
 * Both marks are `font-semibold`, the weight the site's bold copy has always
 * used, so moving the footer and the presence band here changed nothing.
 */
import { cx } from './styles';
import { splitEmphasis } from '../../lib/emphasis';

interface Props {
  /** One line from content, its marks already checked by the schema. */
  text: string;
  /** The line sits on a photo, so a `==` phrase turns `heading`. */
  onPhoto?: boolean;
  /** Extra classes for the `**` runs only, such as a stronger ink. */
  strongClass?: string;
}

const { text, onPhoto = false, strongClass } = Astro.props;

const accentRunClass = onPhoto
  ? cx('font-semibold text-heading')
  : cx('font-semibold text-accent');

const strongRunClass = cx('font-semibold', strongClass);
---

{splitEmphasis(text).map((run) =>
  run.mark === 'gold' ? (
    <strong class={accentRunClass}>{run.text}</strong>
  ) : run.mark === 'strong' ? (
    <strong class={strongRunClass}>{run.text}</strong>
  ) : (
    run.text
  ),
)}
