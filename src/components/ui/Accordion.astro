---
/**
 * A group of disclosure items (spec 0010), in one of two looks. The About
 * page's capability band uses the `bar` look; the FAQ page uses the `list`
 * look (spec 0020).
 *
 * It is the browser's own `<details>` and `<summary>`, with no script at
 * all. A closed item's text stays in the HTML, so find in page and a screen
 * reader still reach it. The `accordion-item` utility in `global.css` hides
 * the browser's disclosure triangle and, where the browser can, slides the
 * panel open and closed.
 *
 * The summary holds plain text, not a heading: a heading inside a `summary`
 * loses its role in some screen readers, and the band's own heading already
 * names the group.
 *
 * **`bar`** (the default), one open at a time. Every item shares one `name`,
 * so opening one closes the other (the browser does that), and the second
 * item ships with `open`. Where the browser does not know the shared `name`
 * yet, items simply open independently, which loses nothing.
 *
 * - Closed, an item is a bar filled with `--color-accent`: its title bold and
 *   `on-accent` (7.71:1), a `plus` in a `canvas` circle at the end.
 * - Open, it is a `panel` card with a `line` border: the title turns
 *   `accent` (5.04:1), the circle `raised`, the icon a `minus`, and the text
 *   sits below.
 * - The icons are `accent` open or closed (7.71:1 on the `canvas` circle,
 *   6.84:1 on `raised`). They must not inherit the closed title's
 *   `on-accent`, which is the circle's own colour. They are decorative
 *   (`Icon` hides them), because the browser already announces the summary
 *   as expandable and its state.
 * - The group carries `focus-contrast`: the base `accent` ring would vanish
 *   against a closed brass bar, so every summary gets the two colour ring
 *   instead, which passes on an open `panel` item too.
 *
 * **`list`**, the FAQ's look (spec 0020, boxes since 2026-11-26), several
 * open at once. No shared `name`, and every item ships closed.
 *
 * - Each item is its own box on the band: a `canvas` fill and a `field`
 *   border (5.04:1 on canvas), 4px apart, the same edge as the search box
 *   above it. Hover lifts the border to `ink-muted`.
 * - The title is `heading` in the display face at `text-body`, set snug
 *   (15.83:1 on canvas), and turns `accent` when open (7.71:1).
 * - A `chevron-down` in `ink` at the end (11.66:1), turning to point up when
 *   the item opens (a 200ms turn, none under reduced motion).
 * - The answer is `ink` (11.66:1), held to a reading width.
 * - The base `accent` ring: the boxes sit on a dark band, where it passes.
 * - An item may carry an `id`, its address (`#id` jumps to it), and `hooks`,
 *   the `data-` attributes a page script reads (the FAQ's search). Each item
 *   is a whole box, so an item a script hides with `hidden` leaves no gap
 *   or stray line behind.
 */
import Emphasis from './Emphasis.astro';
import Icon from './Icon.astro';

type Item = Readonly<{
  title: string;
  /** May carry `**bold**` and `==accent==` phrases. */
  text: string;
  /** The item's address on the page, so `#id` links to it. */
  id?: string;
  /** Script hooks written on the item's `<details>`. */
  hooks?: Readonly<Record<`data-${string}`, string>>;
}>;

type Props =
  | Readonly<{
      variant?: 'bar';
      /** The group's shared `<details name>`; unique on the page. */
      name: string;
      items: readonly Item[];
    }>
  | Readonly<{
      variant: 'list';
      name?: never;
      items: readonly Item[];
    }>;

const { variant = 'bar', items } = Astro.props;
const { name } = Astro.props;
---

{variant === 'bar' ? (
  <div class="focus-contrast flex flex-col gap-4">
    {items.map((item, index) => (
      <details
        id={item.id}
        name={name}
        open={index === 1}
        class="group accordion-item rounded-ui border border-transparent bg-accent open:border-line open:bg-panel"
        {...item.hooks}
      >
        <summary class="flex min-h-11 cursor-pointer items-center justify-between gap-4 rounded-ui px-6 py-4 text-h3 font-bold text-on-accent group-open:text-accent">
          <span>{item.title}</span>
          <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-canvas text-accent group-open:bg-raised">
            <Icon name="plus" size={20} class="group-open:hidden" />
            <Icon name="minus" size={20} class="hidden group-open:block" />
          </span>
        </summary>
        <div class="px-6 pb-6">
          <p>
            <Emphasis text={item.text} />
          </p>
        </div>
      </details>
    ))}
  </div>
) : (
  <div class="flex flex-col gap-1">
    {items.map((item) => (
      <details
        id={item.id}
        class="group accordion-item rounded-ui border border-field bg-canvas transition-colors duration-150 hover:border-ink-muted"
        {...item.hooks}
      >
        <summary class="flex min-h-11 cursor-pointer items-center justify-between gap-6 rounded-ui px-5 py-2.5 font-display text-body leading-snug font-medium text-heading transition-colors duration-150 group-open:text-accent">
          <span class="text-pretty">{item.title}</span>
          <Icon
            name="chevron-down"
            size={20}
            class="shrink-0 text-ink transition-transform duration-200 group-open:rotate-180 motion-reduce:transition-none"
          />
        </summary>
        <div class="max-w-narrow px-5 pb-5">
          <p class="text-ink">
            <Emphasis text={item.text} />
          </p>
        </div>
      </details>
    ))}
  </div>
)}
