---
/**
 * The numbers band: one figure per stat, with an optional heading above
 * (spec 0005, restyled by spec 0010 for the About page).
 *
 * Each number is bold `accent` at `text-h1` size (7.71:1 on canvas) and
 * each label semibold `ink-strong`. The list is centred and never wider than the `content`
 * width, two columns on a phone and four from `md`.
 *
 * With no `heading` there is no `h2`, and the list is named by the section
 * around it: the About page puts it under its `h1` in the same band.
 *
 * The finished numbers are rendered here, at build, already grouped for the
 * page's language. The counter script (`src/scripts/counters.ts`) only
 * replaces text that is already correct, so with no JavaScript, or with
 * reduced motion asked for, the visitor simply sees the final figures.
 *
 * Two data attributes carry what a browser script cannot work out for itself:
 *
 * - `data-count-to` holds the raw number, so the script never has to parse a
 *   grouped string such as "1,200" back into 1200.
 * - `data-locale` holds the resolved locale, because a script cannot see
 *   `Astro.currentLocale`. Without it the count would format in the visitor's
 *   own locale and disagree with the value the page shipped.
 *
 * Each stat is a description list group so the label is genuinely the term and
 * the number its definition. `flex-col-reverse` shows the number above its
 * label while the markup keeps the order a description list requires.
 *
 * `entranceFrom` gives each figure the `entrance` utility (`global.css`), a
 * CSS fade and rise on page load, with steps counting up from it so the
 * figures follow whatever the caller animated before them. Left out, the
 * figures do not move on load.
 */
import type { Locale } from '../../i18n/locales';
import type { StatItem } from '../../lib/content';

interface Props {
  heading?: string;
  /** The id the surrounding Section points at, when there is a heading. */
  headingId?: string;
  items: readonly StatItem[];
  /** The page's language, used to group the numbers and handed to the script. */
  lang: Locale;
  /** The first figure's `--entrance-step`; each next figure adds one. */
  entranceFrom?: number;
}

const { heading, headingId, items, lang, entranceFrom } = Astro.props;

const format = new Intl.NumberFormat(lang);

const entranceStyle = (index: number): string | undefined =>
  entranceFrom === undefined
    ? undefined
    : `--entrance-step: ${entranceFrom + index}`;
---

<div data-stats-band data-locale={lang}>
  {heading && (
    <h2 id={headingId} class="mb-10 text-center">
      {heading}
    </h2>
  )}

  <dl class="mx-auto grid max-w-content grid-cols-2 gap-8 md:grid-cols-4">
    {items.map((item, index) => (
      <div
        class:list={[
          'flex flex-col-reverse items-center gap-2 text-center',
          entranceFrom !== undefined && 'entrance',
        ]}
        style={entranceStyle(index)}
      >
        <dt class="font-semibold text-ink-strong">{item.label}</dt>
        <dd class="text-h1 font-bold text-balance text-accent">
          <span data-count-to={item.value}>{format.format(item.value)}</span>
          {item.suffix && <span>{item.suffix}</span>}
        </dd>
      </div>
    ))}
  </dl>
</div>

{/**
 * The same shape as the nav script in `Header.astro`: one `<script>` importing
 * a module, which Astro bundles and serves. It enhances the numbers already in
 * the markup above, so if it never loads nothing is lost.
 */}
<script>
  import '../../scripts/counters';
</script>
