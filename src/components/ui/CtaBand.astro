---
/**
 * The closing call to action: a self contained gold band (spec 0005).
 *
 * This is deliberately not a `Section` with a third tone. Spec 0003 holds
 * `white` and `tint` as the only two tones, both light, precisely so that no
 * component ever has to adapt to its background. A gold tone would reopen
 * that: inherited tone variables, a card reset, a second focus colour. So the
 * gold lives here, in one band that is always gold and never asks.
 *
 * It repeats `Section`'s padding and width rather than wrapping it, because
 * wrapping would mean giving `Section` the very tone prop this avoids. If a
 * third tone ever becomes the right answer, this component collapses into it.
 *
 * Every colour here is fixed: black heading and text on gold (8.73:1), and a
 * black link with a white label (21.00:1). Nothing on this band reads a tone.
 * The link's focus ring is black, the one documented exception to the sitewide
 * gold-ink ring; see `ctaLinkClass` and `docs/design.md`.
 *
 * The service pages (feature 8) reuse it: every service entry carries a `cta`
 * block of exactly this shape.
 */
import type { Link } from '../../lib/content';
import { ctaLinkClass, cx } from './styles';

interface Props {
  heading: string;
  /** The id this band points at with `aria-labelledby`. */
  headingId: string;
  text: string;
  button: Link;
}

const { heading, headingId, text, button } = Astro.props;
---

<section
  aria-labelledby={headingId}
  class="bg-gold px-4 py-16 md:px-6 md:py-20 lg:px-8 lg:py-24"
>
  <div class="mx-auto flex w-full max-w-narrow flex-col items-center text-center">
    <h2 id={headingId} class="text-balance">
      {heading}
    </h2>
    <p class="mt-4 text-lead text-black">{text}</p>
    <a href={button.href} class={cx('mt-8', ctaLinkClass)}>
      {button.label}
    </a>
  </div>
</section>
