---
/**
 * The site footer: a `canvas` band in three columns on desktop, stacked on a
 * phone. The brand and a short introduction, how to reach the company, and
 * where to follow it. A `line` hairline marks where it starts, since
 * the band above it is usually `canvas` too; it fades out towards both ends
 * (2026-10-13), so the footer opens with a soft rule, not a hard edge.
 *
 * The site links are the header's job alone; the footer does not repeat them.
 * Legal links (the privacy page, feature 13) still sit in the bottom row.
 *
 * The copy is `heading`, and the marked phrases go through `Emphasis`, so a
 * `==accent==` phrase is `accent` and a `**bold**` one stays `heading`. Links
 * and icons turn `accent` on hover. The base focus ring passes here (7.71:1),
 * so the band needs no `focus-contrast`.
 *
 * The social column (2026-10-24, in place of the certification column) names
 * each network beside its mark, so the icon is decorative and the visible
 * name is the link's accessible name.
 */
import { Image } from 'astro:assets';
import Emphasis from './Emphasis.astro';
import Icon from './Icon.astro';
import { bandGutterClass, bandWidthClass, cx } from './styles';
import type { Link, Settings, SocialNetwork } from '../../lib/content';

interface Props {
  legal?: readonly Link[];
  settings: Settings;
  /**
   * The nav item the footer stands for, by its href, read by `nav-spy.ts` on
   * a page that imports it (the same hook as `Section`'s `navSection`).
   */
  navSection?: string;
}

const { legal = [], settings, navSection } = Astro.props;
const { contact, footer } = settings;

/**
 * The social networks' own spelling. `network` is the enum key, which is
 * lowercase; this is the link text a visitor reads and a screen reader says.
 */
const SOCIAL_NAMES: Readonly<Record<SocialNetwork, string>> = {
  linkedin: 'LinkedIn',
  facebook: 'Facebook',
  youtube: 'YouTube',
  x: 'X',
  instagram: 'Instagram',
  tiktok: 'TikTok',
};

/** `https://www.example.com/` shown as `www.example.com`. */
const displayUrl = (url: string): string =>
  url.replace(/^https?:\/\//, '').replace(/\/$/, '');

const telHref = (phone: string): string =>
  `tel:${phone.replace(/[^+\d]/g, '')}`;

const headingClass =
  'text-h3 font-bold tracking-wide text-balance text-heading uppercase';
const linkClass = 'inline-flex min-h-11 items-center hover:text-accent';
const contactItemClass = 'flex items-center gap-3';
const contactIconClass = 'shrink-0 text-accent';
---

<footer
  class="relative bg-canvas text-small text-heading"
  data-nav-section={navSection}
>
  <div
    aria-hidden="true"
    class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-line to-transparent"
  ></div>
  <div class={cx(bandWidthClass.default, bandGutterClass, 'py-16 md:py-20')}>
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3 lg:gap-16">
      <div>
        <Image
          src={settings.logo.src}
          alt={settings.logo.alt ?? ''}
          class="h-12 w-auto"
        />
        <div class="mt-8 flex flex-col gap-4 font-semibold">
          {footer.intro.map((line) => (
            <p>
              <Emphasis text={line} />
            </p>
          ))}
        </div>
      </div>

      <div>
        <h2 class={headingClass}>{footer.contactHeading}</h2>
        <ul class="mt-6 flex list-none flex-col p-0">
          <li class={contactItemClass}>
            <Icon name="phone" size={18} class={contactIconClass} />
            <a href={telHref(contact.phone)} class={linkClass}>
              {contact.phone}
            </a>
          </li>
          <li class={contactItemClass}>
            <Icon name="mail" size={18} class={contactIconClass} />
            <a href={`mailto:${contact.email}`} class={linkClass}>
              {contact.email}
            </a>
          </li>
          {contact.website && (
            <li class={contactItemClass}>
              <Icon name="globe" size={18} class={contactIconClass} />
              <a href={contact.website} class={linkClass}>
                {displayUrl(contact.website)}
              </a>
            </li>
          )}
          <li class={cx(contactItemClass, 'min-h-11 py-2')}>
            <Icon name="map-pin" size={18} class={contactIconClass} />
            <address class="not-italic">{contact.address}</address>
          </li>
        </ul>
      </div>

      {settings.social.length > 0 && (
        <div class="md:col-span-2 lg:col-span-1">
          <h2 class={headingClass}>{footer.socialHeading}</h2>
          <ul class="mt-6 grid list-none grid-cols-2 gap-x-6 p-0">
            {settings.social.map((account) => (
              <li>
                <a
                  href={account.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={cx(linkClass, 'gap-3')}
                >
                  <Icon
                    name={account.network}
                    size={18}
                    class={contactIconClass}
                  />
                  {SOCIAL_NAMES[account.network]}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <div class="mt-12 flex flex-col gap-2 border-t border-line pt-6 md:flex-row md:items-center md:justify-between">
      <p>{footer.copyright}</p>
      {
        /* Feature 13's privacy page lands here as a content edit, with no code
           change. Absent or empty, the row is just the copyright. */
        legal.length > 0 && (
          <ul class="flex list-none flex-wrap gap-x-6 p-0">
            {legal.map((link) => (
              <li>
                <a href={link.href} class="hover:text-accent">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</footer>
