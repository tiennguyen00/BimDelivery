---
/**
 * A heading, some paragraphs, an optional list, and an optional photo beside
 * them (spec 0005).
 *
 * The home page uses it twice, for the company overview and the global
 * presence section, with `imageSide` flipped between them so the two do not
 * read as the same block printed twice. The About page (feature 7) is the
 * reason it lives in `ui/` rather than in `home/`.
 *
 * The image is optional because `presence.image` is optional in the schema
 * (spec 0002). With no image the copy becomes a single centred column rather
 * than half a grid with an empty other half.
 *
 * Mobile always stacks copy first and photo second, whichever side the photo
 * takes at `lg`: reading the words before looking at the picture is the right
 * order, and the visual alternation only matters once there are two columns to
 * alternate between.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  heading: string;
  /** The id the surrounding Section points at with `aria-labelledby`. */
  headingId: string;
  paragraphs: readonly string[];
  image?: { src: ImageMetadata; alt: string };
  /** Which side the photo takes at `lg`. Ignored when there is no photo. */
  imageSide?: 'start' | 'end';
}

const {
  heading,
  headingId,
  paragraphs,
  image,
  imageSide = 'start',
} = Astro.props;

/** Half the split at `lg`, the full column below it. */
const imageSizes = '(min-width: 64rem) 50vw, 100vw';
---

{image ? (
  <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-2 lg:gap-12">
    <div>
      <h2 id={headingId}>{heading}</h2>
      {paragraphs.map((paragraph) => (
        <p class="mt-4 text-lead">{paragraph}</p>
      ))}
      <slot />
    </div>

    {/**
     * The figure is second in the markup so a screen reader and a narrow
     * screen both get the copy first; `lg:order-first` is what moves it to
     * the left once there are two columns.
     */}
    <figure class={imageSide === 'start' ? 'lg:order-first' : undefined}>
      <Image
        src={image.src}
        alt={image.alt}
        widths={[400, 600, 900]}
        sizes={imageSizes}
        loading="lazy"
        class="aspect-3/2 w-full rounded-ui object-cover"
      />
    </figure>
  </div>
) : (
  <div class="mx-auto w-full max-w-narrow">
    <h2 id={headingId}>{heading}</h2>
    {paragraphs.map((paragraph) => (
      <p class="mt-4 text-lead">{paragraph}</p>
    ))}
    <slot />
  </div>
)}
