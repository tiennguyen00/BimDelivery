---
/**
 * A band on a pattern (spec 0013): the surface the service pages' features
 * and process bands sit on, named by the content's `surface` field.
 *
 * - `dark`: a black band under the `bg-dots-dark` dot grid. It is not a
 *   `Section` tone, so it renders its own `<section>`, borrows the band frame
 *   from `styles.ts` like the home hero and `CtaBand`, and carries
 *   `focus-contrast`, the ring for every surface that is not a light tone.
 * - `light`: a white `Section` under the `bg-diagonal` stripe, the home
 *   presence band's surface. No new tone, only the pattern on top.
 *
 * It owns the surface and nothing inside it. What sits here reads the same
 * `surface` through the class maps in `styles.ts` (white words on `dark`;
 * black headings and `ink` text on `light`), and a `==` phrase takes the
 * gold `Emphasis` picks for that surface.
 */
import Section from './Section.astro';
import {
  bandGutterClass,
  bandPaddingClass,
  bandWidthClass,
  cx,
  type Surface,
} from './styles';

interface Props {
  surface: Surface;
  /** The id of the heading this band is named by, for screen readers. */
  labelledBy: string;
  class?: string;
}

const { surface, labelledBy, class: className } = Astro.props;
---

{surface === 'dark' ? (
  <section
    aria-labelledby={labelledBy}
    class={cx(
      'focus-contrast bg-black bg-dots-dark',
      bandGutterClass,
      bandPaddingClass,
      className,
    )}
  >
    <div class={bandWidthClass.default}>
      <slot />
    </div>
  </section>
) : (
  <Section
    tone="white"
    labelledBy={labelledBy}
    class={cx('bg-diagonal', className)}
  >
    <slot />
  </Section>
)}
