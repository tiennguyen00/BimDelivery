---
/**
 * A band on a pattern (spec 0013): the surface the service pages' features
 * and process bands sit on, named by the content's `surface` field. Both are
 * a `canvas` `Section` with a pattern on top, so no new tone (spec 0003,
 * 2026-10-09):
 *
 * - `stripe`: the `bg-diagonal` stripe, the home presence band's surface.
 * - `dots`: the `bg-dots` grid.
 *
 * It owns the pattern and nothing inside it. What sits here takes the same
 * band strings from `styles.ts` on either one, and the base focus ring passes
 * on both (6.66:1 over a stripe line, 5.15:1 at a dot's centre).
 */
import Section from './Section.astro';
import { cx, type BandPattern } from './styles';

interface Props {
  surface: BandPattern;
  /** The id of the heading this band is named by, for screen readers. */
  labelledBy: string;
  class?: string;
}

const { surface, labelledBy, class: className } = Astro.props;

const patterns: Readonly<Record<BandPattern, string>> = {
  stripe: cx('bg-diagonal'),
  dots: cx('bg-dots'),
};
---

<Section
  tone="canvas"
  labelledBy={labelledBy}
  class={cx(patterns[surface], className)}
>
  <slot />
</Section>
