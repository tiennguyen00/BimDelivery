---
/**
 * A card: optional image, a title, optional text, optional link (spec 0003).
 *
 * The whole card is clickable, but through exactly one link and one tab stop.
 * The link wraps the title text and its `::after` is stretched over the card,
 * so the accessible name a screen reader announces is the title rather than
 * "link" or the whole card's text. That is also why a linked card's slot must
 * hold no button, link, or field: the stretched layer would cover it.
 *
 * Hover and keyboard focus are deliberately different treatments. Hover
 * raises the shadow and underlines the title; focus draws one deep gold ring
 * around the whole card, via the `link-focus` variant in global.css. A mouse
 * user is never shown something that reads as a focus ring.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { cx } from './styles';

interface Props {
  title: string;
  text?: string;
  image?: { src: ImageMetadata; alt: string };
  href?: string;
  headingLevel?: 2 | 3 | 4;
  class?: string;
}

const {
  title,
  text,
  image,
  href,
  headingLevel = 3,
  class: className,
} = Astro.props;

const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';

/** One column on mobile, two on tablet, three on desktop. */
const imageSizes = '(min-width: 64rem) 33vw, (min-width: 48rem) 50vw, 100vw';
---

<article
  class:list={[
    'group relative flex h-full flex-col overflow-hidden rounded-ui border border-line bg-white',
    href &&
      'transition-shadow duration-150 hover:shadow-md link-focus:outline-2 link-focus:outline-offset-2 link-focus:outline-gold-ink',
    className,
  ]}
>
  {image && (
    <Image
      src={image.src}
      alt={image.alt}
      widths={[400, 600, 800]}
      sizes={imageSizes}
      class="aspect-3/2 w-full object-cover"
    />
  )}
  <div class="flex flex-1 flex-col gap-2 p-6">
    <Heading class={cx('text-h3 font-semibold text-balance text-ink-strong')}>
      {href ? (
        <a
          href={href}
          class="after:absolute after:inset-0 focus-visible:outline-none group-hover:underline"
        >
          {title}
        </a>
      ) : (
        title
      )}
    </Heading>
    {text && <p class="text-ink-muted">{text}</p>}
    <slot />
  </div>
</article>
