---
/**
 * A full width band with its content centred (spec 0003).
 *
 * Section owns page width and gutters, so no page writes its own container.
 * There are two tones and both are dark, which means every text, border, and
 * focus colour inside is identical on either one: nothing a page puts in here
 * needs to know which tone it landed on.
 *
 * Pages set the rhythm by alternating `canvas` and `raised`. Adjacent sections of
 * the same tone are fine; there is no margin between them, only padding.
 *
 * The gutters, padding, and widths are the shared band frame in `styles.ts`,
 * which `CtaBand` and the home hero also use (spec 0005).
 *
 * Both edges fade into `canvas` over the band's padding (`bandFadeClass`,
 * 2026-10-13), so a `raised` band, or a stripe or dot pattern, eases in and
 * out instead of starting on a hard line. On a plain `canvas` band the fade
 * paints nothing. It sits under the content, inside the band's own stacking
 * context (`isolate`).
 */
import {
  bandFadeClass,
  bandGutterClass,
  bandPaddingClass,
  bandWidthClass,
  cx,
} from './styles';

interface Props {
  tone?: 'canvas' | 'raised';
  width?: 'default' | 'narrow';
  id?: string;
  /** The id of the heading this section is named by, for screen readers. */
  labelledBy?: string;
  /**
   * The nav item this band belongs to, by its href. On a page that imports
   * `nav-spy.ts` the header underline moves to that item while the band is
   * the one in view; anywhere else it is inert.
   */
  navSection?: string;
  class?: string;
}

const {
  tone = 'canvas',
  width = 'default',
  id,
  labelledBy,
  navSection,
  class: className,
} = Astro.props;

const tones = {
  canvas: 'bg-canvas',
  raised: 'bg-raised',
} as const;
---

<section
  id={id}
  aria-labelledby={labelledBy}
  data-nav-section={navSection}
  class:list={[
    'relative isolate',
    bandGutterClass,
    bandPaddingClass,
    tones[tone],
    className,
  ]}
>
  <div aria-hidden="true" class={cx('absolute -z-10', bandFadeClass.top)}></div>
  <div
    aria-hidden="true"
    class={cx('absolute -z-10', bandFadeClass.bottom)}
  ></div>
  <div class={bandWidthClass[width]}>
    <slot />
  </div>
</section>
