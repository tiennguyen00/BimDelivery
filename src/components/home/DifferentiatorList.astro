---
/**
 * The what sets us apart list (spec 0005).
 *
 * A real `<ul>`, so a screen reader announces how many points there are, with
 * the default bullet replaced by a small gold square. The square is drawn as
 * an `aria-hidden` span rather than a `::marker` colour, because the marker
 * would inherit the paragraph colour and a coloured marker is not a thing the
 * token system can express without an arbitrary value.
 *
 * Two columns at `md` and above: the items are short, and a single column of
 * four short lines leaves most of a desktop band empty.
 */
interface Props {
  heading: string;
  /** The id the surrounding Section points at with `aria-labelledby`. */
  headingId: string;
  items: readonly string[];
}

const { heading, headingId, items } = Astro.props;
---

<h2 id={headingId} class="max-w-narrow text-balance">
  {heading}
</h2>

<ul class="mt-10 grid grid-cols-1 gap-x-12 gap-y-4 md:grid-cols-2">
  {items.map((item) => (
    <li class="flex items-start gap-3 border-b border-line py-3 text-lead">
      <span
        aria-hidden="true"
        class="mt-2.5 size-2 shrink-0 rounded-ui bg-gold"
      ></span>
      <span>{item}</span>
    </li>
  ))}
</ul>
