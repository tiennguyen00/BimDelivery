---
/**
 * One home page service card (spec 0005, simplified 2026-10-11): the
 * service's own photo, its two digit number (`01`), the title, and the
 * summary, left aligned with no panel box around them.
 *
 * The photo is the card's own local file when `home.yaml` names one (cut to
 * 4:5 so a wide render is never stretched to fill the frame), else the first
 * one in the service page's intro carousel; the route picks it (a home only
 * card names its own). A fixed frame keeps the photos the same height
 * whatever their source sizes: 4:3 on a phone, so it is not all photo, and
 * 4:5 from `lg`.
 *
 * The whole card is clickable through exactly one link and one tab stop, the
 * same pattern as `Card`: the link wraps the title and its `::after` is
 * stretched over the card, so a screen reader announces the title alone. The
 * number is decorative (`aria-hidden`), since the row's order already carries
 * it, and nothing else in here may be focusable, because the stretched layer
 * would cover it.
 *
 * Hover and keyboard focus show the same thing: the photo eases up to 105
 * percent inside its frame (only under `motion-safe`) and the title turns
 * `accent`. Focus adds the `accent` ring around the whole card. Tailwind's
 * `hover:` applies only on devices that can hover, so a tap never leaves the
 * card stuck in its hover state.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  /** The card's place in the row, from 1; drawn as `01`. */
  number: number;
  title: string;
  summary: string;
  /**
   * The service's page. Left out for a home only card (`services.extra`),
   * which then has no link and no hover: it is not a tab stop at all.
   */
  href?: string;
  /**
   * A local file or a remote photo; `alt` is `''` when the photo is
   * decorative.
   */
  image: { src: ImageMetadata | string; alt: string };
  /**
   * Extra classes on the card's root, for the grid it sits in: the home row
   * places one or two cards by column (spec 0013). Nothing else changes.
   */
  class?: string;
}

const { number, title, summary, href, image, class: className } = Astro.props;

/** A remote photo has no size until Astro reads it; a local file knows its own. */
const source =
  typeof image.src === 'string'
    ? { src: image.src, inferSize: true as const }
    : { src: image.src };
---

<article
  class:list={[
    'relative flex h-full flex-col rounded-ui link-focus:outline-2 link-focus:outline-offset-4 link-focus:outline-accent',
    href && 'group',
    className,
  ]}
>
  <div class="relative aspect-4/3 overflow-hidden rounded-ui bg-panel lg:aspect-4/5">
    <Image
      {...source}
      alt={image.alt}
      widths={[400, 640, 960]}
      sizes="(min-width: 1024px) 30vw, (min-width: 768px) 50vw, 100vw"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 size-full object-cover object-center transition-[scale] duration-500 ease-out motion-safe:group-hover:scale-105 motion-safe:group-has-[a:focus-visible]:scale-105"
    />
  </div>

  <span
    aria-hidden="true"
    class="mt-6 font-display text-h1 font-normal text-heading tabular-nums lining-nums"
  >
    {String(number).padStart(2, '0')}
  </span>

  <h3 class="mt-2 text-h3 font-bold text-balance text-ink-strong transition-colors duration-200 group-hover:text-accent link-focus:text-accent">
    {href ? (
      <a
        href={href}
        class="after:absolute after:inset-0 focus-visible:outline-none"
      >
        {title}
      </a>
    ) : (
      title
    )}
  </h3>

  <p class="mt-2 text-small text-ink-muted">{summary}</p>
</article>
