---
/**
 * The front door's opening screen (spec 0005; redesigned 2026-10-11 after the
 * engineer's reference, not yet folded into the spec). From `lg` it fills the
 * first screen in two columns inside the page's content width: the copy on
 * the start side (a brass eyebrow, a large title, a paragraph, and one
 * button) beside a thin dotted rule, and on the end side the building, cut out
 * on a transparent background, with the page's `h1` set large behind its
 * roof. The site's numbers sit in an outlined bar along the bottom. Below
 * `lg` it is one column: the `h1` and the building, the copy, then the
 * numbers.
 *
 * It is its own band, not a `Section` tone, but it takes `Section`'s frame
 * from `styles.ts` (gutters and the default width), so it lines up with every
 * band below it. It slides up under the header card by `--header-h` and pads
 * its content down by the same amount, so it fills the first screen exactly.
 *
 * The depth is two things in source order, inside one `@container` (the
 * building's column): the `h1`, sized by that column's width
 * (`text-display`, in `cqi`), then the building, pulled up over the bottom of
 * the letters by `hero-overlap` (also in `cqi`). Both scale with the column,
 * so the roof covers the same share of the words at every width. Everything
 * sits on `canvas`, so every word takes the plain dark pairs and the band
 * needs no `focus-contrast`.
 *
 * The building is the page's largest contentful paint, so it loads eagerly
 * and at a high fetch priority. The only thing that moves is the counter, the
 * same `counters.ts` the stat bands use: it counts figures that are already
 * correct in the HTML.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import Emphasis from '../ui/Emphasis.astro';
import Icon from '../ui/Icon.astro';
import { bandGutterClass, bandWidthClass, cx } from '../ui/styles';
import type { Locale } from '../../i18n/locales';
import type { Link, StatItem } from '../../lib/content';

interface Props {
  /** The short line in brass capitals above `subheading`. */
  eyebrow: string;
  /** The display line behind the building. */
  heading: string;
  /** The id this band points at with `aria-labelledby`, on the `h1`. */
  headingId: string;
  /** The large title; a `==phrase==` in it turns brass. */
  subheading: string;
  lead: string;
  /** The building on a transparent background. */
  image: { src: ImageMetadata; alt: string };
  primaryCta: Link;
  stats: readonly StatItem[];
  /** The page's language, used to group the numbers and handed to the script. */
  lang: Locale;
}

const {
  eyebrow,
  heading,
  headingId,
  subheading,
  lead,
  image,
  primaryCta,
  stats,
  lang,
} = Astro.props;

/** The widths the building is generated at, before the source width cap. */
const HERO_STEPS: readonly number[] = [480, 720, 960, 1280];

/**
 * The steps below the source width, then the source width itself, so nothing
 * is ever upscaled. A source under 480px yields just its own width.
 */
const heroWidths = (sourceWidth: number): number[] => [
  ...HERO_STEPS.filter((width) => width < sourceWidth),
  sourceWidth,
];

/** The building's column: the full width below `lg`, about half from it. */
const HERO_SIZES = '(min-width: 64rem) 40vw, 100vw';

const format = new Intl.NumberFormat(lang);

/** The dotted rule's ends: three small dots each. */
const RULE_DOTS: readonly number[] = [0, 1, 2];
---

<section
  aria-labelledby={headingId}
  class={cx(
    bandGutterClass,
    'relative isolate -mt-(--header-h) bg-canvas pt-(--header-h) lg:flex lg:min-h-svh lg:flex-col',
  )}
>
  <div class={cx(bandWidthClass.default, 'flex flex-col lg:flex-1')}>
    <div class="grid items-center gap-10 py-10 md:py-12 lg:flex-1 lg:grid-cols-2 lg:gap-12">
      {/**
       * The building's column, first in the source so the `h1` leads the
       * band; from `lg` it moves to the end side. A faint `raised` glow sits
       * behind it, decoration only.
       */}
      <div class="@container relative lg:col-start-2 lg:row-start-1">
        <div
          aria-hidden="true"
          class="absolute inset-0 -z-10 bg-radial from-raised to-transparent to-70%"
        ></div>
        <h1
          id={headingId}
          class="text-center text-display whitespace-nowrap uppercase"
        >
          {heading}
        </h1>
        <Image
          src={image.src}
          alt={image.alt}
          widths={heroWidths(image.src.width)}
          sizes={HERO_SIZES}
          loading="eager"
          fetchpriority="high"
          class="relative hero-overlap h-auto w-full"
        />
      </div>

      <div class="relative lg:col-start-1 lg:row-start-1 lg:ps-12">
        <div
          aria-hidden="true"
          class="absolute inset-y-0 inset-s-0 hidden flex-col items-center gap-1.5 lg:flex"
        >
          {RULE_DOTS.map(() => (
            <span class="size-1 rounded-full bg-heading" />
          ))}
          <span class="w-px flex-1 bg-heading/30"></span>
          {RULE_DOTS.map(() => (
            <span class="size-1 rounded-full bg-heading" />
          ))}
        </div>

        <p class="text-eyebrow font-semibold text-accent uppercase">
          {eyebrow}
        </p>
        <p class="mt-4 font-display text-h1 font-medium text-balance text-heading">
          <Emphasis text={subheading} />
        </p>
        <p class="mt-6 max-w-narrow text-lead text-ink">{lead}</p>
        <Button href={primaryCta.href} class="mt-8">
          {primaryCta.label}
          <Icon name="arrow-right" size={20} />
        </Button>
      </div>
    </div>

    {/**
     * One description list, as in `StatsBand`: each label is the term and its
     * number the definition, shown number first by `flex-col-reverse`. The
     * icon is hidden, because the label already says what it pictures. An
     * outline on `canvas`, not a filled box, so every pair is a `canvas` one.
     */}
    <dl
      data-stats-band
      data-locale={lang}
      class="mb-10 grid grid-cols-2 gap-y-2 rounded-card border border-line py-4 lg:mb-8 lg:grid-cols-4 lg:divide-x lg:divide-line lg:py-6"
    >
      {stats.map((item) => (
        <div class="flex flex-col items-start gap-3 px-5 py-2 lg:flex-row lg:items-center lg:justify-center lg:gap-4">
          <span
            aria-hidden="true"
            class="grid size-12 shrink-0 place-items-center rounded-full border border-accent"
          >
            <Icon name={item.icon} size={24} class="fill-accent" />
          </span>
          <div class="flex flex-col-reverse">
            <dt class="text-small text-ink-muted">{item.label}</dt>
            <dd class="font-display text-h2 font-semibold text-heading lining-nums">
              <span data-count-to={item.value}>
                {format.format(item.value)}
              </span>
              {item.suffix && <span class="text-accent">{item.suffix}</span>}
            </dd>
          </div>
        </div>
      ))}
    </dl>
  </div>
</section>

{/**
 * The same module `StatsBand` imports. Astro bundles it once however many
 * components ask for it.
 */}
<script>
  import '../../scripts/counters';
</script>
