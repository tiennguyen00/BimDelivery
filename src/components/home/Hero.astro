---
/**
 * The front door's opening screen (spec 0005, revised 2026-09-21): up to three
 * photos in a crossfading carousel, filling the first screen on phones and
 * tablets and 80% of it from `lg` up, so the next band peeks in on desktop, a
 * centred see through dark panel holding the heading and subheading, one
 * button under it, and the carousel's controls at the bottom.
 *
 * It is its own band, not a `Section` tone, because it is not a light surface.
 * It borrows `Section`'s frame from `styles.ts` so its gutters and widths
 * cannot drift from the rest of the page, and it carries `focus-contrast`, the
 * ring for surfaces that are not a light tone.
 *
 * The heading here is the page's only `h1`, which is why the component takes
 * the id rather than inventing one: the band points at the same id with
 * `aria-labelledby`.
 *
 * Three things hold the design together, and each is easy to break quietly:
 *
 * - Text sits only on the scrim, never straight on the photo. `--color-scrim`
 *   is dark enough that white text reaches 5.74:1 over a pure white pixel, so
 *   swapping the photo never needs a contrast check. The band itself is black,
 *   so a photo that fails to load leaves white copy on a dark band.
 * - The band slides up under the header card by `--header-h` and pads its
 *   content down by the same amount, so the panel centres in the visible area
 *   below the card. Both read the one value in `PageLayout`. Nothing between
 *   the header and this band may clip (`overflow`, `contain`), or the part
 *   pulled up under the card disappears.
 * - The carousel is an enhancement. The markup shows the first photo and hides
 *   the rest (transparent, `aria-hidden`), and the controls start `invisible`,
 *   so with no JavaScript the hero is one still photo with nothing dead to
 *   tab to. `src/scripts/hero-carousel.ts` reveals the controls and runs it.
 *   The controls are real buttons, one dot per photo, each with a 24px hit
 *   area around its small visible mark, plus a previous and a next arrow on
 *   the sides that fade in while the pointer is over the band. There is no
 *   pause button: the slideshow holds still while the pointer is over the
 *   band or focus is inside it, and never plays for reduced motion.
 *
 * The scrim panel replays its entrance on every photo change: the heading and
 * its subheading move together as one block, fading in and rising into place
 * from 24px below, the same distance, duration, and curve as the scroll
 * reveal, so the two movements on the page read as one. The script finds the
 * panel by `data-hero-panel`; the button under it stays still, because it is
 * outside the panel and a control that slides away from the pointer is worse
 * than a still one. The entrance never plays on the first paint, because the
 * hero is the largest contentful paint and nothing there may blink, and it
 * never plays at all for reduced motion.
 *
 * Every photo is a white background with its subject in the centre (spec
 * 0006), so the dots are black: black at 30% for the
 * others, solid black for the one showing. The arrows are white circles with
 * a black chevron and a soft shadow, so they read on white and on the panel.
 *
 * The first photo is the page's largest contentful paint, so it is the one
 * image on the site that loads eagerly and at a high fetch priority; the
 * others load lazily. Every photo is positioned to fill the band, so none
 * takes layout space or can shift anything as it arrives.
 */
import { Image, inferRemoteSize } from 'astro:assets';
import Button from '../ui/Button.astro';
import {
  bandGutterClass,
  bandPaddingClass,
  bandWidthClass,
  cx,
} from '../ui/styles';
import type { Link } from '../../lib/content';

interface Props {
  heading: string;
  /** The id this band points at with `aria-labelledby`. */
  headingId: string;
  subheading: string;
  /** One to three photo links (spec 0006), shown in this order. */
  images: readonly { src: string; alt: string }[];
  primaryCta: Link;
}

const { heading, headingId, subheading, images, primaryCta } = Astro.props;

// Read once at build from each link, like a local file's metadata.
const slides = await Promise.all(
  images.map(async (image) => ({
    ...image,
    source: await inferRemoteSize(image.src),
  })),
);
const hasCarousel = slides.length > 1;

/**
 * The previous and next arrows, one on each side, vertically centred in the
 * band. They start `invisible` like the dots, for the same no JavaScript
 * reason. Once revealed they stay transparent until the pointer is over the
 * band, or the arrow itself has keyboard focus, so a keyboard user always sees
 * where they are. Below `md` they are left out: the panel fills the width
 * there, and the dots already do the job.
 */
const heroArrowClass =
  'invisible absolute top-1/2 z-10 hidden size-11 -translate-y-1/2 cursor-pointer place-items-center rounded-full bg-white text-black opacity-0 shadow-md transition-opacity duration-300 group-hover/hero:opacity-100 focus-visible:opacity-100 md:grid';

/** The widths the photo is generated at, before the source width cap. */
const HERO_STEPS: readonly number[] = [640, 960, 1280, 1920];
/** Wider than this is never worth the bytes, even on a large monitor. */
const HERO_MAX_WIDTH = 2560;

/**
 * The steps below the source width, then the source width itself capped at
 * 2560, so a wider photo later gains the larger steps with no code change and
 * nothing is ever upscaled. A source under 640px yields just its own width.
 */
const heroWidths = (sourceWidth: number): number[] => {
  const cap = Math.min(sourceWidth, HERO_MAX_WIDTH);
  return [...HERO_STEPS.filter((width) => width < cap), cap];
};
---

<section
  aria-labelledby={headingId}
  data-hero-carousel={hasCarousel ? '' : undefined}
  class={cx(
    'group/hero focus-contrast relative isolate -mt-(--header-h) flex min-h-svh flex-col bg-black lg:min-h-[80svh]',
    bandGutterClass,
  )}
>
  {slides.map(({ src, alt, source }, index) => (
    <Image
      src={src}
      alt={alt}
      width={source.width}
      height={source.height}
      widths={heroWidths(source.width)}
      sizes="100vw"
      loading={index === 0 ? 'eager' : 'lazy'}
      fetchpriority={index === 0 ? 'high' : undefined}
      aria-hidden={index === 0 ? undefined : 'true'}
      data-hero-slide
      class={cx(
        'absolute inset-0 -z-10 size-full object-cover object-center transition-opacity duration-1000',
        index === 0 ? 'opacity-100' : 'opacity-0',
      )}
    />
  ))}

  {hasCarousel && (
    <>
      <button
        type="button"
        data-hero-arrow="prev"
        aria-label="Show the previous photo"
        class={cx(heroArrowClass, 'inset-s-4 lg:inset-s-8')}
      >
        <svg aria-hidden="true" viewBox="0 0 16 16" class="size-4">
          <path
            d="M10 3 5 8l5 5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
      <button
        type="button"
        data-hero-arrow="next"
        aria-label="Show the next photo"
        class={cx(heroArrowClass, 'inset-e-4 lg:inset-e-8')}
      >
        <svg aria-hidden="true" viewBox="0 0 16 16" class="size-4">
          <path
            d="m6 3 5 5-5 5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
    </>
  )}

  <div class="flex flex-1 flex-col items-center justify-center pt-(--header-h)">
    <div class={cx(bandPaddingClass, 'flex w-full flex-col items-center')}>
      <div
        data-hero-panel
        class={cx(
          bandWidthClass.default,
          'rounded-ui bg-scrim px-6 py-8 text-center md:px-10 md:py-10',
        )}
      >
        <h1 id={headingId} class="text-balance text-white">
          {heading}
        </h1>
        <p class="mt-6 text-lead text-white">{subheading}</p>
      </div>

      <Button href={primaryCta.href} class="mt-8">
        {primaryCta.label}
      </Button>
    </div>
  </div>

  {hasCarousel ? (
    <div
      data-hero-controls
      class="invisible flex items-center justify-center gap-1 pb-8"
    >
      {slides.map((_, index) => (
        <button
          type="button"
          data-hero-dot
          aria-label={`Show photo ${index + 1} of ${slides.length}`}
          aria-current={index === 0 ? 'true' : 'false'}
          class="group grid size-6 cursor-pointer place-items-center rounded-full"
        >
          <span class="size-2.5 rounded-full bg-black/30 transition-colors group-aria-current:bg-black" />
        </button>
      ))}
    </div>
  ) : (
    <div class="pb-8" />
  )}
</section>

{/**
 * The same shape as the counters in `StatsBand.astro`: one `<script>`
 * importing a module, which Astro bundles and serves.
 */}
<script>
  import '../../scripts/hero-carousel';
</script>
