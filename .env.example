# Copy to .env (git ignored). `pnpm build` reads it; `pnpm dev` reads
# .env.development instead.
#
# The contact form's Cloudflare Turnstile site key (spec 0011). Public by
# design, and inlined into the page's JavaScript at build, so the build fails
# without it.
# - Local builds: Cloudflare's always passing test key below is fine.
# - The dev link (built here with CLOUDFLARE_ENV=dev): the real site key.
# - The live site: set the real key as a build variable on the Worker
#   (Settings, Build, Variables and secrets), not in a file.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
