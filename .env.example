# Copy to .env (git ignored). `pnpm dev` and `pnpm build` read it.
#
# Nothing here is required: every build variable has a default in
# astro.config.mjs's env schema.
#
# Send test enquiries from `pnpm dev` to your own inbox instead of the team's
# (spec 0022). The sender must stay on the domain verified in Resend.
# CONTACT_TO_EMAIL="you@example.com"
#
# Read Sanity drafts, only to build the dev link (spec 0019).
# SANITY_READ_TOKEN=""
